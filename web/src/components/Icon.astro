---
// Hairline line icons (1px stroke, square terminals) to match the thin type.
interface Props {
  name: 'work' | 'about' | 'writing' | 'arrow' | 'external' | 'download' | 'mail' | 'linkedin';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="square"
  aria-hidden="true"
>
  {
    name === 'work' && (
      <>
        <rect x="2.5" y="2.5" width="6" height="6" />
        <rect x="11.5" y="2.5" width="6" height="6" />
        <rect x="2.5" y="11.5" width="6" height="6" />
        <rect x="11.5" y="11.5" width="6" height="6" />
      </>
    )
  }
  {
    name === 'about' && (
      <>
        <circle cx="10" cy="7" r="3.5" />
        <path d="M3.5 17.5c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" />
      </>
    )
  }
  {
    name === 'writing' && (
      <>
        <path d="M3.5 5.5h13M3.5 10h13M3.5 14.5h8" />
      </>
    )
  }
  {name === 'arrow' && <path d="M4 10h12M11.5 5.5 16 10l-4.5 4.5" />}
  {name === 'external' && <path d="M6 14 14 6M7.5 6H14v6.5" />}
  {name === 'download' && <path d="M10 3.5v10M5.5 9 10 13.5 14.5 9M4 16.5h12" />}
  {
    name === 'mail' && (
      <>
        <rect x="2.5" y="4.5" width="15" height="11" />
        <path d="m2.5 5 7.5 6 7.5-6" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="2.5" y="2.5" width="15" height="15" />
        <path d="M6.5 8.5v5.5M6.5 6v.01M9.5 14V8.5M9.5 11c0-1.5 1-2.5 2.3-2.5S14 9.3 14 11v3" />
      </>
    )
  }
</svg>
