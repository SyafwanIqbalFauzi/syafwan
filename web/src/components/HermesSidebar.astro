---
// Navigation for the private areas: /agent (Hermes) and /finance (money), in two levels.
//  1. A narrow rail with the areas (and search). It reopens the page you last used in that area.
//     On phones the same rail becomes a bar at the bottom of the screen.
//  2. The pages of the current area, grouped, with the signed-in account at the bottom.
// Ctrl+K (or the search button) opens a palette to jump to any page. On phones the page list folds
// into a top bar with a menu button.
import Pictogram from './Pictogram.astro';
import { AREA_ORDER, AREAS, type Area, type Section } from '../lib/nav';
import { readItems } from '../lib/directus-user';
import { attentionParams, DUPLICATE_WINDOW_MS, visibleAttention, type RunRow } from '../lib/updates';

export type { Area, Section };

interface Props {
  current?: Section;
  email?: string;
  area?: Area;
}
const { current, email, area = 'agent' } = Astro.props;

const groups = AREAS[area].groups;
// Accounts sits at the bottom of the rail, right above Search.
const railOrder = [...AREA_ORDER.filter((key) => key !== 'accounts'), ...AREA_ORDER.filter((key) => key === 'accounts')];
const AREA_NAME: Record<Area, string> = { agent: 'agents', finance: 'finance', accounts: 'accounts', persib: 'persib' };
const AREA_PICTOGRAM: Record<Area, Section | 'persib'> = { agent: 'agents', finance: 'finance', accounts: 'accounts', persib: 'persib' };
const brand = { href: AREAS[area].home, name: AREA_NAME[area] };

// Results that wait for a look from the owner (badge on the Persib rail link and its page entry).
// Best effort: a slow or failing Directus must never slow down or break the page around it.
let waiting = 0;
const token = Astro.locals.hermesToken;
if (token) {
  try {
    const KEYS = 'id,job_id,execution_id,summary,started_at';
    const count = async (): Promise<number> => {
      const flagged = await readItems<RunRow>(token, 'agent_runs', { ...attentionParams(), limit: 100, fields: KEYS });
      if (flagged.data.length === 0) return 0;
      // The feed hides the `file:` copy of a run stored twice; fetch the neighbours so the badge hides it too.
      const times = flagged.data.map((r) => Date.parse(r.started_at ?? '')).filter(Number.isFinite);
      const nearby = times.length
        ? await readItems<RunRow>(token, 'agent_runs', {
            'filter[job_id][_in]': [...new Set(flagged.data.map((r) => r.job_id))].join(','),
            'filter[started_at][_gte]': new Date(Math.min(...times) - DUPLICATE_WINDOW_MS).toISOString(),
            'filter[started_at][_lte]': new Date(Math.max(...times) + DUPLICATE_WINDOW_MS).toISOString(),
            limit: 200,
            fields: KEYS,
          })
        : { data: [] as RunRow[] };
      return visibleAttention(flagged.data, nearby.data).length;
    };
    const result = await Promise.race([count(), new Promise<null>((resolve) => setTimeout(() => resolve(null), 1500))]);
    waiting = result ?? 0;
  } catch {
    waiting = 0;
  }
}
---

<aside class="sidebar" data-sidebar data-area={area}>
  <nav class="rail" aria-label="Area">
    {
      railOrder.map((key) => (
        <a href={AREAS[key].home} class={key === 'accounts' ? 'rail-link rail-account' : 'rail-link'} data-area-link={key} aria-current={key === area ? 'true' : undefined}>
          <Pictogram name={AREA_PICTOGRAM[key]} size={22} />
          <span class="rail-label">{AREAS[key].label}</span>
          {key === 'persib' && waiting > 0 && <span class="rail-dot" title={`${waiting} waiting for your check`} aria-label={`${waiting} waiting for your check`}>{waiting > 99 ? '99+' : waiting}</span>}
        </a>
      ))
    }
    <button type="button" class="rail-link rail-search" data-palette-open aria-keyshortcuts="Control+K Meta+K" title="Go to a page (Ctrl+K)">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="M13.5 13.5L20 20" stroke="currentColor" stroke-width="2.4" /></svg>
      <span class="rail-label">Search</span>
    </button>
  </nav>

  <div class="side-body">
  <div class="side-top">
    <a href={brand.href} class="brand">syafwan <span>/ {brand.name}</span></a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="side-nav" data-menu-toggle>menu</button>
  </div>

  <nav id="side-nav" class="side-nav" aria-label={area === 'agent' ? 'Hermes' : AREAS[area].label}>
    {
      groups.map((group) => (
        <div class="group">
          <p class="group-label">{group.label}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} class="entry" aria-current={item.section === current ? 'page' : undefined}>
                  <Pictogram name={item.section} size={18} />
                  <span>{item.label}</span>
                  {item.section === 'chat' && <span class="work-badge" data-work-badge hidden>working</span>}
                  {item.section === 'updates' && waiting > 0 && <span class="work-badge" data-state="wait">{waiting} to check</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="side-foot">
    {email && <p class="who" title={email}>{email}</p>}
    {area === 'agent' && <button type="button" class="alerts" data-alerts aria-pressed="true">alerts: on</button>}
    <form method="post" action="/agent/logout">
      <button type="submit" class="signout">sign out</button>
    </form>
  </div>
  </div>
</aside>

<script>
  import { pageFor, rememberPage, type Area } from '../lib/nav';
  import { initPalette } from '../scripts/nav-palette';

  // Remember the page, so the rail reopens it later; and send the rail links there now.
  rememberPage(localStorage, location.pathname);
  document.querySelectorAll<HTMLAnchorElement>('[data-area-link]').forEach((link) => {
    const key = link.dataset.areaLink as Area;
    if (link.getAttribute('aria-current') !== 'true') link.href = pageFor(localStorage, key);
  });
  initPalette();

  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  toggle?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Chat turns run on the server and carry on while you look at other pages or other conversations.
  // Every run this browser started and that has not been opened since is checked here every few
  // seconds: the badge next to "Chat" summarises them, the chat page marks each conversation in its
  // list (through an 'agent:runs' event), and a sound + pop-up says when one needs you or finishes.
  // Nothing here ever switches the conversation you are looking at.
  import { clearActiveRun, loadActiveRuns } from '../lib/chat-run';
  import { alertFor, alertsEnabled, alertUser, firstTime, setAlerts } from '../lib/notify';
  import { stateOf, summarize, type RunState } from '../lib/run-badge';

  const badge = document.querySelector<HTMLElement>('[data-work-badge]');

  /** Checks every remembered run once. Returns true while at least one is still going. */
  async function checkRuns(): Promise<boolean> {
    const runs = loadActiveRuns(localStorage);
    const states: Record<string, RunState> = {};
    let going = false;
    await Promise.all(
      runs.map(async (run) => {
        try {
          const res = await fetch(`/api/agent/runs/${encodeURIComponent(run.runId)}`, { credentials: 'same-origin' });
          if (res.status === 404) return clearActiveRun(localStorage, run.sessionId);
          const status = res.ok ? await res.json() : null;
          const text = status ? alertFor(status.status, run.message) : null;
          if (text && firstTime(localStorage, run.runId, text.kind)) alertUser(text, { onChatPage: location.pathname.startsWith('/agent/chat') });
          // A finished run stays remembered until its conversation is opened (that shows the result and clears it).
          const state = stateOf(status?.status);
          states[run.sessionId] = state;
          if (state !== 'done') going = true;
        } catch {
          states[run.sessionId] = 'busy'; // offline: keep showing it and try again
          going = true;
        }
      }),
    );
    const summary = summarize(Object.values(states));
    if (badge) {
      badge.hidden = !summary;
      if (summary) {
        badge.textContent = summary.text;
        badge.dataset.state = summary.state;
      }
    }
    (window as any).__agentRunStates = states;
    window.dispatchEvent(new CustomEvent('agent:runs', { detail: states }));
    return going;
  }

  let ticking = false;
  async function tick() {
    ticking = true;
    if (await checkRuns()) setTimeout(tick, 8_000);
    else ticking = false;
  }
  const start = () => {
    if (!ticking) void tick();
  };
  // The chat page tells us when it starts a run (this script already ran by then).
  window.addEventListener('agent:run-saved', start);
  if (loadActiveRuns(localStorage).length) start();

  const alertsBtn = document.querySelector<HTMLButtonElement>('[data-alerts]');
  const paintAlerts = () => {
    const on = alertsEnabled(localStorage);
    if (!alertsBtn) return;
    alertsBtn.textContent = `alerts: ${on ? 'on' : 'off'}`;
    alertsBtn.setAttribute('aria-pressed', String(on));
    alertsBtn.title = on ? 'Sound and pop-up when Hermes needs you or finishes. Click to turn off.' : 'Click to turn on sound and pop-up alerts.';
  };
  paintAlerts();
  alertsBtn?.addEventListener('click', async () => {
    const result = await setAlerts(!alertsEnabled(localStorage));
    paintAlerts();
    if (result === 'on-no-popup' && alertsBtn) alertsBtn.title = 'Sound is on. Pop-ups are blocked in this browser; allow notifications for this site to get them.';
  });

</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    background: var(--te-page);
    border-right: 1px solid var(--te-grey-100);
  }

  /* Level 1: the areas */
  .rail {
    flex: none;
    width: 68px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--s-4);
    padding: var(--s-22) var(--s-4);
    background: var(--te-white);
    border-right: 1px solid var(--te-grey-100);
  }

  .rail-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-11) 2px var(--s-8);
    font-size: 11px;
    line-height: 1.2;
    border-left: 2px solid transparent;
    color: var(--te-grey-600);
    cursor: pointer;
  }

  .rail-link:hover {
    background: var(--te-page);
    color: var(--te-black);
  }

  .rail-link[aria-current='true'] {
    background: var(--te-page);
    color: var(--te-black);
    border-left-color: var(--te-black);
    font-weight: var(--w-regular);
  }

  .rail-account {
    margin-top: auto;
  }

  /* Count of results waiting for the owner, on the Persib rail link */
  .rail-dot {
    position: absolute;
    top: 4px;
    right: 6px;
    min-width: 16px;
    padding: 0 var(--s-4);
    font-size: 10px;
    line-height: 16px;
    text-align: center;
    background: var(--te-orange);
    color: var(--te-black);
  }

  /* Level 2: the pages of the area */
  .side-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--s-22) var(--s-15);
    overflow-y: auto;
  }

  .side-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--s-8) var(--s-22);
  }

  .brand {
    font-size: var(--text-sub);
    font-weight: var(--w-thin);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .brand span {
    color: var(--te-grey-600);
  }

  .menu-btn {
    display: none;
    font-size: var(--text-caption);
    border: 1px solid currentColor;
    padding: var(--s-4) var(--s-11);
  }

  .side-nav {
    flex: 1;
    display: grid;
    align-content: start;
    gap: var(--s-22);
  }

  .group-label {
    padding: 0 var(--s-8) var(--s-4);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--te-grey-600);
  }

  .entry {
    display: flex;
    align-items: center;
    gap: var(--s-11);
    padding: var(--s-8) var(--s-8);
    font-size: var(--text-body);
    font-weight: var(--w-light);
    border-left: 2px solid transparent;
  }

  .entry:hover {
    background: var(--te-white);
  }

  .work-badge {
    margin-left: auto;
    padding: 2px var(--s-4);
    font-size: 11px;
    line-height: 1.2;
    border: 1px solid var(--te-amber);
    background: var(--te-amber);
    color: var(--te-black);
    animation: work-pulse 1.6s ease-in-out infinite;
  }

  .work-badge[data-state='done'] {
    animation: none;
    background: var(--te-page);
    border-color: var(--te-black);
  }

  .work-badge[data-state='wait'] {
    animation: none;
    background: var(--te-black);
    border-color: var(--te-black);
    color: var(--te-white);
  }

  @keyframes work-pulse {
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-badge {
      animation: none;
    }
  }

  .entry[aria-current='page'] {
    background: var(--te-white);
    border-left-color: var(--te-black);
    font-weight: var(--w-regular);
  }

  .side-foot {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-15) var(--s-8) 0;
    border-top: 1px solid var(--te-grey-100);
    font-size: var(--text-caption);
  }

  .who {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .alerts {
    justify-self: start;
    font-size: var(--text-caption);
    color: var(--te-grey-600);
  }

  .alerts:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .signout {
    justify-self: start;
    margin-top: var(--s-4);
    font-weight: var(--w-regular);
  }

  .signout:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Phone / narrow window: top bar (brand + menu), areas as a bar at the bottom of the screen */
  @media (max-width: 899px) {
    .sidebar {
      position: sticky;
      top: 0;
      z-index: 20;
      display: block;
      height: auto;
      max-height: 100dvh;
      border-right: 0;
      border-bottom: 1px solid var(--te-grey-100);
      background: var(--te-page);
      overflow-y: auto;
    }

    .side-body {
      display: block;
      overflow: visible;
      padding: var(--s-15) var(--gutter);
      padding-top: max(var(--s-15), env(safe-area-inset-top));
    }

    .rail {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 25;
      width: auto;
      height: calc(var(--rail-h) + env(safe-area-inset-bottom));
      flex-direction: row;
      gap: 0;
      padding: 0 0 env(safe-area-inset-bottom);
      border-right: 0;
      border-top: 1px solid var(--te-grey-100);
      background: var(--te-page);
    }

    .rail-link {
      flex: 1;
      min-height: 0;
      padding-block: var(--s-4);
      justify-content: center;
      border-left: 0;
      border-top: 2px solid transparent;
    }

    .rail-link[aria-current='true'] {
      border-left-color: transparent;
      border-top-color: var(--te-black);
    }

    .rail-account {
      margin-top: 0;
    }

    .menu-btn {
      display: inline-block;
      min-height: 44px;
      padding-inline: var(--s-15);
    }

    .side-nav a {
      padding-block: var(--s-11);
    }

    .side-top {
      padding: 0;
    }

    .side-nav,
    .side-foot {
      display: none;
    }

    .sidebar.open .side-nav,
    .sidebar.open .side-foot {
      display: grid;
    }

    .sidebar.open .side-nav,
    .sidebar.open .side-foot {
      margin-top: var(--s-15);
    }
  }
</style>
