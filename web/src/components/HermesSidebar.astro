---
// Left sidebar for the private areas: /agent (Hermes) and /finance (money). A conventional CMS menu:
// brand, grouped entries with small icons, a switch to the other area, and the signed-in account at
// the bottom. On phones it folds into a top bar with a menu button.
import Pictogram from './Pictogram.astro';

export type Section = 'overview' | 'agents' | 'skills' | 'chat' | 'sessions' | 'usage' | 'finance' | 'transactions' | 'budgets' | 'categories';
export type Area = 'agent' | 'finance';

interface Props {
  current?: Section;
  email?: string;
  area?: Area;
}
const { current, email, area = 'agent' } = Astro.props;

type Group = { label: string; items: { section: Section; href: string; label: string }[] };

const agentGroups: Group[] = [
  {
    label: 'Workspace',
    items: [
      { section: 'overview', href: '/agent', label: 'Overview' },
      { section: 'chat', href: '/agent/chat', label: 'Chat' },
    ],
  },
  {
    label: 'Automation',
    items: [
      { section: 'agents', href: '/agent/agents', label: 'Agents' },
      { section: 'skills', href: '/agent/skills', label: 'Skills' },
    ],
  },
  {
    label: 'History',
    items: [
      { section: 'sessions', href: '/agent/sessions', label: 'Sessions' },
      { section: 'usage', href: '/agent/usage', label: 'Usage' },
    ],
  },
];

const financeGroups: Group[] = [
  {
    label: 'Money',
    items: [
      { section: 'finance', href: '/finance', label: 'Dashboard' },
      { section: 'transactions', href: '/finance/transactions', label: 'Transactions' },
      { section: 'budgets', href: '/finance/budgets', label: 'Budgets' },
      { section: 'categories', href: '/finance/categories', label: 'Categories' },
    ],
  },
];

const groups = area === 'finance' ? financeGroups : agentGroups;
const brand = area === 'finance' ? { href: '/finance', name: 'finance' } : { href: '/agent', name: 'agents' };
---

<aside class="sidebar" data-sidebar>
  <div class="side-top">
    <a href={brand.href} class="brand">syafwan <span>/ {brand.name}</span></a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="side-nav" data-menu-toggle>menu</button>
  </div>

  <nav class="area-switch" aria-label="Area">
    <a href="/agent" aria-current={area === 'agent' ? 'true' : undefined}>Agents</a>
    <a href="/finance" aria-current={area === 'finance' ? 'true' : undefined}>Finance</a>
  </nav>

  <nav id="side-nav" class="side-nav" aria-label={area === 'finance' ? 'Finance' : 'Hermes'}>
    {
      groups.map((group) => (
        <div class="group">
          <p class="group-label">{group.label}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={item.href} class="entry" aria-current={item.section === current ? 'page' : undefined}>
                  <Pictogram name={item.section} size={18} />
                  <span>{item.label}</span>
                  {item.section === 'chat' && <span class="work-badge" data-work-badge hidden>working</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="side-foot">
    {email && <p class="who" title={email}>{email}</p>}
    {area === 'agent' && <button type="button" class="alerts" data-alerts aria-pressed="true">alerts: on</button>}
    <form method="post" action="/agent/logout">
      <button type="submit" class="signout">sign out</button>
    </form>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  toggle?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // A chat turn runs on the server and carries on while you look at other pages. If this browser
  // started one that has not finished, say so next to "Chat" and check on it now and then.
  import { clearActiveRun, loadActiveRun } from '../lib/chat-run';
  import { alertFor, alertsEnabled, alertUser, firstTime, setAlerts } from '../lib/notify';

  const badge = document.querySelector<HTMLElement>('[data-work-badge]');
  const FINISHED = ['completed', 'failed', 'cancelled', 'interrupted'];

  async function checkRun() {
    const run = loadActiveRun(localStorage);
    if (!badge || !run) {
      if (badge) badge.hidden = true;
      return false;
    }
    try {
      const res = await fetch(`/api/agent/runs/${encodeURIComponent(run.runId)}`, { credentials: 'same-origin' });
      if (res.status === 404) {
        clearActiveRun(localStorage);
        badge.hidden = true;
        return false;
      }
      const status = res.ok ? await res.json() : null;
      const text = status ? alertFor(status.status, run.message) : null;
      if (text && firstTime(localStorage, run.runId, text.kind)) alertUser(text, { onChatPage: location.pathname.startsWith('/agent/chat') });
      if (status && FINISHED.includes(status.status)) {
        // Finished while nobody was watching: keep the entry so the chat page can clear it and show the result.
        badge.textContent = 'done';
        badge.dataset.state = 'done';
        badge.hidden = false;
        return false;
      }
      badge.textContent = status?.status === 'waiting_for_approval' ? 'needs you' : 'working';
      badge.dataset.state = status?.status === 'waiting_for_approval' ? 'wait' : 'busy';
      badge.hidden = false;
      return true;
    } catch {
      return true; // offline: keep the last state and try again
    }
  }

  const alertsBtn = document.querySelector<HTMLButtonElement>('[data-alerts]');
  const paintAlerts = () => {
    const on = alertsEnabled(localStorage);
    if (!alertsBtn) return;
    alertsBtn.textContent = `alerts: ${on ? 'on' : 'off'}`;
    alertsBtn.setAttribute('aria-pressed', String(on));
    alertsBtn.title = on ? 'Sound and pop-up when Hermes needs you or finishes. Click to turn off.' : 'Click to turn on sound and pop-up alerts.';
  };
  paintAlerts();
  alertsBtn?.addEventListener('click', async () => {
    const result = await setAlerts(!alertsEnabled(localStorage));
    paintAlerts();
    if (result === 'on-no-popup' && alertsBtn) alertsBtn.title = 'Sound is on. Pop-ups are blocked in this browser; allow notifications for this site to get them.';
  });

  if (badge && loadActiveRun(localStorage)) {
    const tick = async () => {
      if (await checkRun()) setTimeout(tick, 8_000);
    };
    void tick();
  }
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--te-page);
    border-right: 1px solid var(--te-grey-100);
    padding: var(--s-22) var(--s-15);
    overflow-y: auto;
  }

  .side-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px var(--s-22);
  }

  .brand {
    font-size: var(--text-sub);
    font-weight: var(--w-thin);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .brand span {
    color: var(--te-grey-600);
  }

  .menu-btn {
    display: none;
    font-size: var(--text-caption);
    border: 1px solid currentColor;
    padding: 6px 12px;
  }

  /* Switch between the two private areas: always visible, also on a phone */
  .area-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0 8px var(--s-22);
    border: 1px solid var(--te-black);
    font-size: var(--text-caption);
  }

  .area-switch a {
    padding: 7px 10px;
    text-align: center;
  }

  .area-switch a:hover {
    background: var(--te-white);
  }

  .area-switch a[aria-current='true'] {
    background: var(--te-black);
    color: var(--te-white);
  }

  @media (max-width: 899px) {
    .area-switch {
      margin: var(--s-15) 0 0;
    }
  }

  .side-nav {
    flex: 1;
    display: grid;
    align-content: start;
    gap: var(--s-22);
  }

  .group-label {
    padding: 0 8px 6px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--te-grey-600);
  }

  .entry {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 8px;
    font-size: var(--text-body);
    font-weight: var(--w-light);
    border-left: 2px solid transparent;
  }

  .entry:hover {
    background: var(--te-white);
  }

  .work-badge {
    margin-left: auto;
    padding: 2px 6px;
    font-size: 11px;
    line-height: 1.2;
    border: 1px solid var(--te-amber);
    background: var(--te-amber);
    color: var(--te-black);
    animation: work-pulse 1.6s ease-in-out infinite;
  }

  .work-badge[data-state='done'] {
    animation: none;
    background: var(--te-page);
    border-color: var(--te-black);
  }

  .work-badge[data-state='wait'] {
    animation: none;
    background: var(--te-black);
    border-color: var(--te-black);
    color: var(--te-white);
  }

  @keyframes work-pulse {
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-badge {
      animation: none;
    }
  }

  .entry[aria-current='page'] {
    background: var(--te-white);
    border-left-color: var(--te-black);
    font-weight: var(--w-regular);
  }

  .side-foot {
    display: grid;
    gap: 4px;
    padding: var(--s-15) 8px 0;
    border-top: 1px solid var(--te-grey-100);
    font-size: var(--text-caption);
  }

  .who {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .alerts {
    justify-self: start;
    font-size: var(--text-caption);
    color: var(--te-grey-600);
  }

  .alerts:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .signout {
    justify-self: start;
    margin-top: 6px;
    font-weight: var(--w-regular);
  }

  .signout:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Phone / narrow window: top bar, menu hidden until the button is pressed */
  @media (max-width: 899px) {
    .sidebar {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--te-grey-100);
      padding: var(--s-15) var(--gutter);
      overflow: visible;
    }

    .side-top {
      padding: 0;
    }

    .menu-btn {
      display: inline-block;
    }

    .side-nav,
    .side-foot {
      display: none;
    }

    .sidebar.open .side-nav,
    .sidebar.open .side-foot {
      display: grid;
    }

    .sidebar.open .side-nav {
      margin-top: var(--s-15);
    }

    .sidebar.open .side-foot {
      margin-top: var(--s-15);
    }
  }
</style>
