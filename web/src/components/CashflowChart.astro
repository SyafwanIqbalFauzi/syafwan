---
// Income vs expense per day / week / month as paired bars, drawn as SVG on the server.
// Every pair has a <title> (hover tooltip) and the numbers are repeated in a table below
// for screen readers and for reading exact values.
import { labelStep, niceAxis } from '../lib/chart';
import { rupiah, rupiahShort, type CashflowPoint } from '../lib/finance';

interface Props {
  points: CashflowPoint[];
  bucketName: string; // "day" | "week" | "month"
}
const { points, bucketName } = Astro.props;

const W = 800;
const H = 280;
const M = { top: 12, right: 8, bottom: 30, left: 64 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;
const axis = niceAxis(0, Math.max(0, ...points.flatMap((p) => [p.income, p.expense])));
const y = (v: number) => M.top + plotH - ((v - axis.min) / (axis.max - axis.min)) * plotH;
const slot = plotW / Math.max(1, points.length);
const barW = Math.max(2, Math.min(22, slot * 0.36));
const step = labelStep(points.length);
const empty = points.every((p) => p.income === 0 && p.expense === 0);
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Income and expense per ${bucketName}`} preserveAspectRatio="xMidYMid meet">
    {
      axis.ticks.map((tick) => (
        <g>
          <line x1={M.left} x2={W - M.right} y1={y(tick)} y2={y(tick)} class="grid" />
          <text x={M.left - 8} y={y(tick) + 4} text-anchor="end" class="axis">{rupiahShort(tick).replace('Rp ', '')}</text>
        </g>
      ))
    }
    {
      points.map((p, i) => {
        const cx = M.left + slot * i + slot / 2;
        return (
          <g>
            <title>{`${p.label}${p.partial ? ' (part of the ' + bucketName + ')' : ''}\nIncome ${rupiah(p.income)}\nExpense ${rupiah(p.expense)}\nNet ${rupiah(p.net)}`}</title>
            <rect x={M.left + slot * i} y={M.top} width={slot} height={plotH} class="hit" />
            {p.income > 0 && <rect x={cx - barW - 1} y={y(p.income)} width={barW} height={y(0) - y(p.income)} class={p.partial ? 'in partial' : 'in'} />}
            {p.expense > 0 && <rect x={cx + 1} y={y(p.expense)} width={barW} height={y(0) - y(p.expense)} class={p.partial ? 'out partial' : 'out'} />}
            {i % step === 0 && <text x={cx} y={H - 10} text-anchor="middle" class="axis">{p.label}</text>}
          </g>
        );
      })
    }
    <line x1={M.left} x2={W - M.right} y1={y(0)} y2={y(0)} class="base" />
  </svg>
  <figcaption class="legend">
    <span><i class="swatch in"></i> Income</span>
    <span><i class="swatch out"></i> Expense</span>
    {points.some((p) => p.partial) && <span class="muted">Faded bars: only part of that {bucketName} falls inside the period.</span>}
    {empty && <span class="muted">No transactions in this period.</span>}
  </figcaption>
  <details class="chart-table">
    <summary>Show as table</summary>
    <table>
      <thead><tr><th>{bucketName}</th><th class="num">Income</th><th class="num">Expense</th><th class="num">Net</th></tr></thead>
      <tbody>
        {points.map((p) => <tr><td>{p.label}</td><td class="num">{rupiah(p.income)}</td><td class="num">{rupiah(p.expense)}</td><td class="num">{rupiah(p.net)}</td></tr>)}
      </tbody>
    </table>
  </details>
</figure>
