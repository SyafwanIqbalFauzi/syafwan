---
// Solid black pictograms for the main navigation, after teenage.engineering's
// header (pinwheel, store bag, frame, finder): flat shapes, no strokes to speak of.
// Cut-outs use the page colour so they read as negative space.
interface Props {
  name: 'work' | 'about' | 'writing' | 'overview' | 'agents' | 'chat' | 'sessions' | 'usage' | 'skills' | 'finance' | 'transactions' | 'budgets' | 'categories';
  size?: number;
}
const { name, size = 56 } = Astro.props;
---

<svg class="pictogram" width={size} height={size} viewBox="0 0 56 56" aria-hidden="true">
  {
    name === 'work' && (
      <>
        <rect x="2" y="2" width="24" height="24" class="fill" />
        <rect x="30" y="2" width="24" height="24" class="fill" />
        <rect x="2" y="30" width="24" height="24" class="fill" />
        <rect x="32" y="32" width="20" height="20" class="frame" />
      </>
    )
  }
  {
    name === 'about' && (
      <>
        <circle cx="28" cy="16" r="13" class="fill" />
        <path d="M4 54C4 38 15 31 28 31S52 38 52 54Z" class="fill" />
      </>
    )
  }
  {
    name === 'writing' && (
      <>
        <path d="M6 2H38L50 14V54H6Z" class="fill" />
        <path d="M38 2V14H50" class="cut" />
        <rect x="13" y="24" width="30" height="3" class="cut" />
        <rect x="13" y="33" width="30" height="3" class="cut" />
        <rect x="13" y="42" width="18" height="3" class="cut" />
      </>
    )
  }
  {
    name === 'overview' && (
      <>
        <rect x="2" y="2" width="52" height="18" class="fill" />
        <rect x="2" y="24" width="24" height="30" class="fill" />
        <rect x="32" y="26" width="20" height="26" class="frame" />
      </>
    )
  }
  {
    name === 'agents' && (
      <>
        <rect x="26" y="2" width="4" height="9" class="fill" />
        <circle cx="28" cy="4" r="4" class="fill" />
        <rect x="6" y="11" width="44" height="40" class="fill" />
        <rect x="14" y="23" width="9" height="9" class="cut" />
        <rect x="33" y="23" width="9" height="9" class="cut" />
        <rect x="18" y="40" width="20" height="4" class="cut" />
      </>
    )
  }
  {
    name === 'chat' && (
      <>
        <path d="M4 4H52V38H24L12 52V38H4Z" class="fill" />
        <rect x="13" y="14" width="30" height="3" class="cut" />
        <rect x="13" y="22" width="22" height="3" class="cut" />
      </>
    )
  }
  {
    name === 'sessions' && (
      <>
        <rect x="4" y="4" width="40" height="12" class="fill" />
        <rect x="8" y="22" width="40" height="12" class="fill" />
        <rect x="12" y="40" width="40" height="12" class="frame" />
      </>
    )
  }
  {
    name === 'usage' && (
      <>
        <rect x="4" y="30" width="12" height="22" class="fill" />
        <rect x="22" y="16" width="12" height="36" class="fill" />
        <rect x="40" y="4" width="12" height="48" class="fill" />
      </>
    )
  }
  {
    name === 'finance' && (
      <>
        <rect x="4" y="34" width="12" height="18" class="fill" />
        <rect x="22" y="22" width="12" height="30" class="fill" />
        <rect x="40" y="8" width="12" height="44" class="fill" />
        <rect x="2" y="52" width="52" height="3" class="fill" />
      </>
    )
  }
  {
    name === 'transactions' && (
      <>
        <path d="M8 2H48V54L40 48L32 54L24 48L16 54L8 48Z" class="fill" />
        <rect x="15" y="14" width="26" height="3" class="cut" />
        <rect x="15" y="23" width="26" height="3" class="cut" />
        <rect x="15" y="32" width="16" height="3" class="cut" />
      </>
    )
  }
  {
    name === 'budgets' && (
      <>
        <circle cx="28" cy="28" r="24" class="fill" />
        <circle cx="28" cy="28" r="15" class="cut" />
        <circle cx="28" cy="28" r="7" class="fill" />
      </>
    )
  }
  {
    name === 'categories' && (
      <>
        <rect x="4" y="4" width="21" height="21" class="fill" />
        <rect x="31" y="4" width="21" height="21" class="fill" />
        <rect x="4" y="31" width="21" height="21" class="fill" />
        <rect x="31" y="31" width="21" height="21" class="cut" />
        <rect x="33" y="33" width="17" height="17" fill="none" stroke="currentColor" stroke-width="3" />
      </>
    )
  }
  {
    name === 'skills' && (
      <>
        <path d="M4 16H20V12a6 6 0 0 1 12 0V16H48V32H44a6 6 0 0 0 0 12H48V52H4Z" class="fill" />
      </>
    )
  }
</svg>

<style>
  .pictogram {
    flex: none;
  }

  .fill {
    fill: currentColor;
  }

  .frame {
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
  }

  .cut {
    fill: var(--te-page);
  }
</style>
