---
// Running net (income minus expense) over the chosen period as a line with a soft area under it.
import { labelStep, linePath, niceAxis } from '../lib/chart';
import { rupiah, rupiahShort, type CashflowPoint } from '../lib/finance';

interface Props {
  points: CashflowPoint[];
  bucketName: string;
}
const { points, bucketName } = Astro.props;

const W = 800;
const H = 220;
const M = { top: 12, right: 8, bottom: 30, left: 64 };
const plotW = W - M.left - M.right;
const plotH = H - M.top - M.bottom;
const values = points.map((p) => p.cumulative);
const axis = niceAxis(Math.min(0, ...values), Math.max(0, ...values));
const y = (v: number) => M.top + plotH - ((v - axis.min) / (axis.max - axis.min)) * plotH;
const slot = plotW / Math.max(1, points.length);
const xs = points.map((_, i) => M.left + slot * i + slot / 2);
const coords = points.map((p, i) => ({ x: xs[i], y: y(p.cumulative) }));
const line = linePath(coords);
const area = coords.length ? `${line} L${coords.at(-1)!.x.toFixed(1)} ${y(0).toFixed(1)} L${coords[0].x.toFixed(1)} ${y(0).toFixed(1)} Z` : '';
const step = labelStep(points.length);
const last = points.at(-1)?.cumulative ?? 0;
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Running net per ${bucketName}; ends at ${rupiah(last)}`} preserveAspectRatio="xMidYMid meet">
    {
      axis.ticks.map((tick) => (
        <g>
          <line x1={M.left} x2={W - M.right} y1={y(tick)} y2={y(tick)} class="grid" />
          <text x={M.left - 8} y={y(tick) + 4} text-anchor="end" class="axis">{rupiahShort(tick).replace('Rp ', '')}</text>
        </g>
      ))
    }
    <line x1={M.left} x2={W - M.right} y1={y(0)} y2={y(0)} class="base" />
    {area && <path d={area} class="area" />}
    {line && <path d={line} class="trend" />}
    {
      points.map((p, i) => (
        <g>
          <title>{`${p.label}\nRunning net ${rupiah(p.cumulative)}\nThis ${bucketName}: ${rupiah(p.net)}`}</title>
          <rect x={M.left + slot * i} y={M.top} width={slot} height={plotH} class="hit" />
          {points.length <= 31 && <circle cx={xs[i]} cy={y(p.cumulative)} r="2.5" class="dot" />}
          {i % step === 0 && <text x={xs[i]} y={H - 10} text-anchor="middle" class="axis">{p.label}</text>}
        </g>
      ))
    }
  </svg>
</figure>
