---
// Footer after teenage.engineering: a carbon band with one large centred call to
// action, a hairline, then a quiet row of thin links and the copyright.
import { t, type Locale } from '../lib/i18n';
import type { Profile } from '../lib/schema';

interface Props {
  locale: Locale;
  profile: Profile | null;
}
const { locale, profile } = Astro.props;
const year = new Date().getFullYear();
const name = profile?.full_name ?? 'Syafwan Iqbal Fauzi';

const links = [
  { href: `/${locale}/work`, label: t(locale, 'nav.work') },
  { href: `/${locale}/about`, label: t(locale, 'nav.about') },
  { href: `/${locale}/writing`, label: t(locale, 'nav.writing') },
  ...(profile?.email ? [{ href: `mailto:${profile.email}`, label: 'email' }] : []),
  ...(profile?.linkedin_url ? [{ href: profile.linkedin_url, label: 'linkedin', external: true }] : []),
];
---

<footer class="band-dark footer" id="contact">
  <div class="cta">
    {
      profile?.email ? (
        <a href={`mailto:${profile.email}`} class="cta-link">
          {t(locale, 'footer.cta')}
        </a>
      ) : (
        <span class="cta-link">{t(locale, 'footer.cta')}</span>
      )
    }
    <p class="cta-body">{t(locale, 'home.contact.body')}</p>
    {profile?.email && <p class="cta-email">{profile.email}</p>}
  </div>
  <div class="bottom">
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={'external' in link ? '_blank' : undefined}
              rel={'external' in link ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="copy">©{year} {name.toLowerCase()}</p>
  </div>
</footer>

<style>
  .footer {
    color: var(--te-grey-100);
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: var(--s-33) var(--gutter);
    text-align: center;
    border-bottom: 1px solid rgb(229 229 229 / 0.35);
  }

  .cta-link {
    font-size: var(--text-h1);
    font-weight: var(--w-thin);
    line-height: 1.11;
  }

  a.cta-link:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .cta-body,
  .cta-email {
    font-size: var(--text-caption);
    color: var(--te-grey-300);
  }

  .bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-15);
    align-items: center;
    padding: var(--s-33) var(--gutter);
    font-size: var(--text-sub);
    font-weight: var(--w-thin);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--s-22);
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 1000px) {
    .bottom {
      grid-template-columns: 1fr auto 1fr;
    }

    .links {
      grid-column: 2;
      justify-content: center;
    }

    .copy {
      text-align: right;
    }
  }
</style>
