---
// Shell for the private /hermes area: no site nav/footer, no Directus content, never indexed.
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--te-page);
    color: var(--te-carbon);
    font-family: var(--font);
  }
</style>
