---
// Page shell for every /hermes page: a plain CMS layout (sidebar on the left, content on the
// right). Colours, type and spacing come from the public site's design tokens (global.css);
// only the structure differs from the public pages. Never loads Directus content, never indexed.
import '@fontsource-variable/inter';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/hermes.css';
import HermesSidebar, { type Section } from '../components/HermesSidebar.astro';

interface Props {
  title: string;
  /** Which sidebar entry is active. Omit together with `bare` on the sign-in page. */
  current?: Section;
  /** Sign-in page: no sidebar, content centred. */
  bare?: boolean;
  /** Fill the viewport (chat): the page itself does not scroll. */
  fill?: boolean;
}
const { title, current, bare = false, fill = false } = Astro.props;
const email = Astro.locals.hermesUser?.email;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} — agents</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['cms-body', { fill }]}>
    <a href="#main" class="skip label">Skip to content</a>
    {
      bare ? (
        <main id="main" class="cms-bare">
          <p class="cms-brand"><a href="/hermes">syafwan <span>/ agents</span></a></p>
          <slot />
        </main>
      ) : (
        <div class="cms">
          <HermesSidebar current={current} email={email} />
          <main id="main" class="cms-main">
            <slot />
          </main>
        </div>
      )
    }
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: var(--gutter);
    top: 8px;
    background: var(--te-black);
    color: var(--te-white);
    padding: 6px 10px;
    z-index: 30;
  }

  .cms {
    flex: 1;
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr);
    min-height: 100dvh;
  }

  .cms-main {
    min-width: 0;
  }

  body.fill {
    height: 100dvh;
    overflow: hidden;
  }

  body.fill .cms {
    height: 100dvh;
    min-height: 0;
  }

  body.fill .cms-main {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .cms-bare {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100dvh;
    padding: var(--s-33) var(--gutter);
  }

  .cms-brand {
    align-self: flex-start;
    font-size: var(--text-sub);
    font-weight: var(--w-thin);
  }

  .cms-brand span {
    color: var(--te-grey-600);
  }

  @media (max-width: 899px) {
    .cms {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
  }
</style>
