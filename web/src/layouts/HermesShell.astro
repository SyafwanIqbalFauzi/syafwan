---
// Page shell for every /agent and /finance page: a plain CMS layout (sidebar on the left, content on the
// right). Colours, type and spacing come from the public site's design tokens (global.css);
// only the structure differs from the public pages. Never loads Directus content, never indexed.
import '@fontsource-variable/inter';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/cms/index.css';
import '../styles/cms-layout.css';
import HermesSidebar, { type Area, type Section } from '../components/HermesSidebar.astro';

interface Props {
  title: string;
  /** Which sidebar entry is active. Omit together with `bare` on the sign-in page. */
  current?: Section;
  /** Sign-in page: no sidebar, content centred. */
  bare?: boolean;
  /** Fill the viewport (chat): the page itself does not scroll. */
  fill?: boolean;
  /** Which private area this page belongs to: its own sidebar, brand and title. */
  area?: Area;
}
const { title, current, bare = false, fill = false, area = 'agent' } = Astro.props;
const email = Astro.locals.hermesUser?.email;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} — {area === 'agent' ? 'agents' : area}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={['cms-body', { fill }]}>
    <a href="#main" class="skip label">Skip to content</a>
    {
      bare ? (
        <main id="main" class="cms-bare">
          <p class="cms-brand"><a href="/agent">syafwan <span>/ agents</span></a></p>
          <slot />
        </main>
      ) : (
        <div class="cms">
          <HermesSidebar current={current} email={email} area={area} />
          <main id="main" class="cms-main">
            <slot />
          </main>
        </div>
      )
    }
    <script>
      import { showFlash } from '../scripts/toast';
      showFlash();
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: var(--gutter);
    top: 8px;
    background: var(--te-black);
    color: var(--te-white);
    padding: var(--s-4) var(--s-11);
    z-index: 30;
  }

  .cms {
    --rail-h: 58px; /* the bar of areas at the bottom of a phone screen */
    flex: 1;
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    min-height: 100dvh;
  }

  .cms-main {
    min-width: 0;
  }

  /* --app-h is the part of the screen that is really visible (set by the chat script from visualViewport:
     the on-screen keyboard on iPhones does not shrink dvh). Without it, dvh. */
  body.fill {
    min-height: 0; /* global.css gives body min-height: 100vh, which would keep it taller than --app-h */
    height: var(--app-h, 100dvh);
    overflow: hidden;
  }

  body.fill .cms {
    height: var(--app-h, 100dvh);
    min-height: 0;
  }

  body.fill .cms-main {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .cms-bare {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100dvh;
    padding: var(--s-33) var(--gutter);
  }

  .cms-brand {
    align-self: flex-start;
    font-size: var(--text-sub);
    font-weight: var(--w-thin);
  }

  .cms-brand span {
    color: var(--te-grey-600);
  }

  @media (max-width: 899px) {
    /* Phone: a plain column, so the top bar (sidebar) can stay pinned while the page scrolls. */
    .cms {
      display: block;
      /* room for the bar of areas at the bottom of the screen */
      padding-bottom: calc(var(--rail-h) + env(safe-area-inset-bottom));
    }

    body.fill .cms {
      display: flex;
      flex-direction: column;
    }

    body.fill .cms-main {
      flex: 1;
    }

    /* Keyboard open: the whole screen goes to the conversation and the box (the top bar returns when it closes). */
    html[data-keyboard] body.fill .sidebar {
      display: none;
    }

    html[data-keyboard] body.fill .cms {
      padding-bottom: 0;
    }
  }
</style>
