---
import HermesShell from '../../layouts/HermesShell.astro';
import FilterBar from '../../components/FilterBar.astro';
import {
  readItems,
  type FinanceBudget,
  type FinanceCategory,
  type FinanceMember,
  type FinanceTransaction,
} from '../../lib/directus-user';
import {
  budgetReport,
  customWindow,
  daysIn,
  dashboardFigures,
  monthEnd,
  monthStart,
  parseDate,
  parseHidden,
  peopleIn,
  percent,
  rupiah,
  summarize,
  todayWib,
  windowFor,
  withoutPeople,
} from '../../lib/finance';

export const prerender = false;

const token = Astro.locals.hermesToken!;
const today = todayWib();
const from = parseDate(Astro.url.searchParams.get('from'));
const to = parseDate(Astro.url.searchParams.get('to'));
const custom = customWindow(from, to, today);
// No dates picked: the last 30 days.
const win = custom ?? windowFor('1m', today);
const thisMonth = { from: monthStart(today), to: monthEnd(today) };
const year = Number(today.slice(0, 4));

// One read covers the chosen period, the period before it (for the comparison) and the
// current month (for the budgets). The charts are drawn in the browser from these rows, so
// switching a person off in a legend needs no new request.
const since = [win.prevStart, thisMonth.from].sort()[0];
const [trxResult, catResult, budgetResult, memberResult] = await Promise.all([
  readItems<FinanceTransaction>(token, 'finance_transactions', {
    'filter[dihapus_pada][_null]': 'true',
    'filter[tanggal][_gte]': since,
    sort: '-tanggal',
    limit: -1,
    fields: 'id,tanggal,jenis,kategori,nominal,member,deskripsi',
  }).catch(() => null),
  readItems<FinanceCategory>(token, 'finance_categories', { limit: -1, sort: 'sort' }).catch(() => null),
  readItems<FinanceBudget>(token, 'finance_budgets', { 'filter[tahun][_eq]': year, limit: -1 }).catch(() => null),
  readItems<FinanceMember>(token, 'finance_members', { limit: -1 }).catch(() => null),
]);

const members = memberResult?.data ?? [];
const memberAsked = Astro.url.searchParams.get('member');
const member = members.find((m) => String(m.id) === memberAsked) ?? null;
const categories = catResult?.data ?? [];

const everyone = trxResult?.data ?? [];
const forPerson = member ? everyone.filter((t) => t.member === member.id) : everyone;
const people = member ? [] : peopleIn(forPerson, win.start, win.end, members.map((m) => ({ id: m.id, name: m.nama_panggilan })));
const asked = parseHidden(Astro.url.searchParams.get('hide')).filter((k) => people.some((w) => w.key === k));
const hidden = asked.length < people.length ? asked : [];

// First paint of the figures; the page script keeps them in step with the legends afterwards.
const trx = withoutPeople(forPerson, hidden);
const now = summarize(trx, win.start, win.end);
const before = summarize(trx, win.prevStart, win.prevEnd);
const figures = dashboardFigures(now, before, daysIn(win));

const budgets = budgetReport(budgetResult?.data ?? [], categories, everyone, year, thisMonth.from, thisMonth.to);
const perPerson = members
  .map((m) => ({ name: m.nama_panggilan, ...summarize(everyone.filter((t) => t.member === m.id), win.start, win.end) }))
  .filter((p) => p.count > 0);
const bucketName = { day: 'day', week: 'week', month: 'month' }[win.bucket];
const loaded = trxResult !== null;

// Only what the charts need: the period and the one before it.
const payload = {
  rows: forPerson
    .filter((t) => t.tanggal >= win.prevStart && t.tanggal <= win.end)
    .map((t) => ({ tanggal: t.tanggal, jenis: t.jenis, kategori: t.kategori, nominal: Number(t.nominal), member: t.member, deskripsi: t.deskripsi })),
  categories: categories.map((c) => ({ id: c.id, nama: c.nama, jenis: c.jenis })),
  members: members.map((m) => ({ id: m.id, name: m.nama_panggilan })),
  win: { start: win.start, end: win.end, prevStart: win.prevStart, prevEnd: win.prevEnd, bucket: win.bucket },
  hidden,
  single: Boolean(member),
};
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<HermesShell title="Finance" current="finance" area="finance">
  <div class="container page" data-finance>
    <div class="page-head">
      <h1 class="h1">Finance</h1>
      <p class="label muted">{win.start} to {win.end}{member ? ` · ${member.nama_panggilan}` : ''}</p>
    </div>

    {!loaded && <p class="notice error" role="alert">Could not read the finance data.</p>}

    <FilterBar
      resetHref={Astro.url.pathname}
      keep={{ hide: hidden.join(',') }}
      dateRange={{ from: win.start, to: win.end, custom: Boolean(custom) }}
      selects={[
        { name: 'member', label: 'Person', value: member ? String(member.id) : null, all: 'Everyone', options: members.map((m) => ({ value: String(m.id), label: m.nama_panggilan })) },
      ]}
    />

    <p class="label muted note-lead" data-hidden-note hidden></p>

    <section class="block">
      <div class="figures">
        <div class="figure">
          <p class="value" data-fig="income-value">{figures.income.value}</p>
          <p class="label">income</p>
          <p class="delta" data-fig="income-delta" data-good={figures.income.good}>{figures.income.delta}</p>
        </div>
        <div class="figure">
          <p class="value" data-fig="expense-value">{figures.expense.value}</p>
          <p class="label">expense</p>
          <p class="delta" data-fig="expense-delta" data-good={figures.expense.good}>{figures.expense.delta}</p>
        </div>
        <div class="figure">
          <p class="value" data-fig="savings-value">{figures.savings.value}</p>
          <p class="label">savings</p>
          <p class="delta" data-fig="savings-delta" data-good={figures.savings.good}>{figures.savings.delta}</p>
        </div>
        <div class="figure">
          <p class="value" data-fig="net-value">{figures.net.value}</p>
          <p class="label" data-fig="net-label">{figures.net.label}</p>
          <p class="delta" data-fig="net-sub">{figures.net.sub}</p>
        </div>
        <div class="figure">
          <p class="value" data-fig="average-value">{figures.average.value}</p>
          <p class="label">average spend per day</p>
          <p class="delta" data-fig="average-sub">{figures.average.sub}</p>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="block-head"><h2>Income and expense</h2><p class="label muted">per {bucketName}</p></div>
      <p class="legend" data-legend="both" hidden></p>
      <div class="chart-box" style="height: 300px"><canvas data-chart="cashflow" role="img" aria-label={`Income and expense per ${bucketName}`}></canvas></div>
      <details class="chart-table">
        <summary>Show as table</summary>
        <div data-cashflow-table></div>
      </details>
    </section>

    <section class="block">
      <div class="block-head"><h2>Running net</h2><p class="label muted">income minus expense and savings since {win.start}</p></div>
      <div class="chart-box" style="height: 220px"><canvas data-chart="net" role="img" aria-label="Running net over the period"></canvas></div>
    </section>

    <section class="block two-col">
      <div>
        <div class="block-head"><h2>Where the money went</h2><p class="label muted" data-total="expense"></p></div>
        <p class="legend" data-legend="expense" hidden></p>
        <div class="chart-box" data-share-box="expense"><canvas data-chart="spend" role="img" aria-label="Spending per category"></canvas></div>
        <p class="empty" data-empty="expense" hidden>No expenses in this period.</p>
      </div>
      <div>
        <div class="block-head"><h2>Where it came from</h2><p class="label muted" data-total="income"></p></div>
        <p class="legend" data-legend="income" hidden></p>
        <div class="chart-box" data-share-box="income"><canvas data-chart="source" role="img" aria-label="Income per category"></canvas></div>
        <p class="empty" data-empty="income" hidden>No income in this period.</p>
      </div>
    </section>

    <section class="block">
      <div class="block-head">
        <h2>Budgets this month</h2>
        <p class="label muted">{thisMonth.from.slice(0, 7)} · everyone together</p>
      </div>
      {
        budgets.expenses.length || budgets.income.length || budgets.savings.length ? (
          <>
            <div class="budget-grid">
              {budgets.expenses.map((b) => (
                <div class="budget" data-level={b.level}>
                  <div class="budget-head">
                    <span class="name" style="font-size: var(--text-body)">{b.name}</span>
                    <span class="num">{percent(b.ratio)}</span>
                  </div>
                  <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.min(100, Math.round(b.ratio * 100))} aria-label={`${b.name} budget used`}>
                    <span style={`width: ${Math.min(100, Math.max(1, b.ratio * 100))}%`}></span>
                  </div>
                  <p class="sub">{rupiah(b.actual)} of {rupiah(b.planned)}{b.ratio > 1 ? ` · over by ${rupiah(b.actual - b.planned)}` : ''}</p>
                  <p class="sub">{b.items.join(', ')}</p>
                </div>
              ))}
            </div>
            {budgets.income.length > 0 && (
              <>
                <div class="block-head" style="margin-top: var(--s-33)"><h2>Expected income</h2><p class="label muted">a target, not a limit</p></div>
                <div class="budget-grid">
                  {budgets.income.map((b) => (
                    <div class="budget" data-level="normal">
                      <div class="budget-head">
                        <span class="name" style="font-size: var(--text-body)">{b.name}</span>
                        <span class="num">{percent(b.ratio)}</span>
                      </div>
                      <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.min(100, Math.round(b.ratio * 100))} aria-label={`${b.name} received`}>
                        <span style={`width: ${Math.min(100, Math.max(1, b.ratio * 100))}%`}></span>
                      </div>
                      <p class="sub">{rupiah(b.actual)} received of {rupiah(b.planned)} expected</p>
                    </div>
                  ))}
                </div>
              </>
            )}
            {budgets.savings.length > 0 && (
              <>
                <div class="block-head" style="margin-top: var(--s-33)"><h2>Planned savings</h2><p class="label muted">a target, not a limit</p></div>
                <div class="budget-grid">
                  {budgets.savings.map((b) => (
                    <div class="budget" data-level="normal">
                      <div class="budget-head">
                        <span class="name" style="font-size: var(--text-body)">{b.name}</span>
                        <span class="num">{percent(b.ratio)}</span>
                      </div>
                      <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.min(100, Math.round(b.ratio * 100))} aria-label={`${b.name} saved`}>
                        <span style={`width: ${Math.min(100, Math.max(1, b.ratio * 100))}%`}></span>
                      </div>
                      <p class="sub">{rupiah(b.actual)} saved of {rupiah(b.planned)} planned</p>
                      <p class="sub">{b.items.join(', ')}</p>
                    </div>
                  ))}
                </div>
              </>
            )}
            <p class="label muted" style="margin-top: var(--s-15)">
              Budgeted categories: {rupiah(budgets.actualOnBudgeted)} spent of {rupiah(budgets.plannedExpense)} planned. Categories without a budget are not counted here.
            </p>
          </>
        ) : (
          <p class="empty">No budgets set for {year}.</p>
        )
      }
    </section>

    <section class="block two-col">
      <div>
        <div class="block-head"><h2>Biggest expenses</h2><a class="arrow-link" href="/finance/transactions?type=pengeluaran&sort=-nominal">all transactions</a></div>
        <div class="ruled" data-biggest></div>
        <p class="empty" data-empty="biggest" hidden>No expenses in this period.</p>
      </div>
      {
        !member && perPerson.length > 1 && (
          <div>
            <div class="block-head"><h2>By person</h2><p class="label muted">who recorded it</p></div>
            <div class="ruled">
              {perPerson.map((p) => (
                <div class="share-row" style="grid-template-columns: 1fr 1fr 1fr">
                  <span>{p.name}<br /><span class="sub">{p.count} transactions</span></span>
                  <span class="num">in {rupiah(p.income)}</span>
                  <span class="num">out {rupiah(p.expense)}</span>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </section>

    <p class="label muted">Amounts are in rupiah, grouped by the calendar day (WIB) of each transaction.</p>

    <script type="application/json" id="finance-data" set:html={payloadJson} />
  </div>
</HermesShell>

<script>
  import '../../scripts/finance-dashboard';
</script>
