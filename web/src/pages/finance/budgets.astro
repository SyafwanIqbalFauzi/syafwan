---
import HermesShell from '../../layouts/HermesShell.astro';
import FilterBar from '../../components/FilterBar.astro';
import { readItems, type FinanceBudget, type FinanceCategory } from '../../lib/directus-user';
import { percent, rupiah, todayWib } from '../../lib/finance';
import { parseYear } from '../../lib/budget-input';

export const prerender = false;

const token = Astro.locals.hermesToken!;
const today = todayWib();
const thisYear = Number(today.slice(0, 4));
const year = parseYear(Astro.url.searchParams.get('year')) ?? thisYear;

const [budgetResult, catResult] = await Promise.all([
  readItems<FinanceBudget>(token, 'finance_budgets', { limit: -1, sort: 'id' }).catch(() => null),
  readItems<FinanceCategory>(token, 'finance_categories', { limit: -1, sort: 'sort' }).catch(() => null),
]);

const allBudgets = budgetResult?.data ?? [];
const categories = catResult?.data ?? [];
const budgets = allBudgets.filter((b) => b.tahun === year);
const years = [...new Set([...allBudgets.map((b) => b.tahun), thisYear, thisYear + 1])].sort();
const previousYearLines = allBudgets.filter((b) => b.tahun === year - 1).length;

const jenisOf = new Map(categories.map((c) => [c.id, c.jenis]));
const amountOf = (b: FinanceBudget) => Number(b.jumlah) || 0;
const spendingPlan = budgets.filter((b) => jenisOf.get(b.kategori) !== 'pemasukan').reduce((a, b) => a + amountOf(b), 0);
const incomePlan = budgets.filter((b) => jenisOf.get(b.kategori) === 'pemasukan').reduce((a, b) => a + amountOf(b), 0);
// How much of the expected income the spending plan takes. Null when no income is planned.
const shareOfIncome = (amount: number) => (incomePlan > 0 ? amount / incomePlan : null);
const spendShare = shareOfIncome(spendingPlan);
const leftShare = shareOfIncome(incomePlan - spendingPlan);
const budgeted = new Set(budgets.map((b) => b.kategori));
const unbudgeted = categories.filter((c) => c.aktif && c.jenis === 'pengeluaran' && !budgeted.has(c.id));

// Groups: income always on top, then the spending categories, each in the order of the category list.
const categoryName = new Map(categories.map((c) => [c.id, c.nama]));
const incomeLines = budgets.filter((b) => jenisOf.get(b.kategori) === 'pemasukan');
// One fixed "Income" group on top (whatever income category a line belongs to), then one group per spending category.
const groups = [
  ...(incomeLines.length ? [{ title: 'Income', income: true, lines: incomeLines, total: incomePlan }] : []),
  ...categories
    .filter((c) => c.jenis !== 'pemasukan' && budgeted.has(c.id))
    .map((c) => {
      const lines = budgets.filter((b) => b.kategori === c.id);
      return { title: c.nama, income: false, lines, total: lines.reduce((sum, b) => sum + amountOf(b), 0) };
    }),
];
const loaded = budgetResult !== null && catResult !== null;
---

<HermesShell title="Budgets" current="budgets" area="finance">
  <div class="container page" data-budgets data-year={year} data-previous-lines={previousYearLines}>
    <div class="page-head">
      <h1 class="h1">Budgets</h1>
      <p class="label muted">monthly amounts for {year}</p>
    </div>

    {!loaded && <p class="notice error" role="alert">Could not read the budgets.</p>}
    <p class="notice" data-budget-banner hidden role="status"></p>

    <FilterBar
      resetHref={Astro.url.pathname}
      selects={[{ name: 'year', label: 'Year', value: year === thisYear ? null : String(year), all: String(thisYear), options: years.filter((y) => y !== thisYear).map((y) => ({ value: String(y), label: String(y) })) }]}
    />

    <section class="block">
      <div class="figures figures-money">
        <div class="figure"><p class="value">{rupiah(spendingPlan)}</p><p class="label">planned spending per month</p><p class="delta">{spendShare === null ? 'no expected income set' : `${percent(spendShare, 1)} of expected income`}</p></div>
        <div class="figure"><p class="value">{rupiah(incomePlan)}</p><p class="label">expected income per month</p></div>
        <div class="figure"><p class="value">{rupiah(incomePlan - spendingPlan)}</p><p class="label">left over per month, if all goes to plan</p><p class="delta">{leftShare === null ? '' : `${percent(leftShare, 1)} of expected income`}</p></div>
        <div class="figure"><p class="value">{budgets.length}</p><p class="label">budget lines</p></div>
      </div>
    </section>

    {
      spendShare !== null && (
        <section class="block">
          <div class="budget" data-level={spendShare >= 1 ? 'critical' : spendShare >= 0.9 ? 'warning' : 'normal'}>
            <div class="budget-head">
              <span class="name" style="font-size: var(--text-body)">Planned spending of expected income</span>
              <span class="num">{percent(spendShare, 1)}</span>
            </div>
            <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.min(100, Math.round(spendShare * 100))} aria-label="Planned spending as a share of expected income">
              <span style={`width: ${Math.min(100, Math.max(1, spendShare * 100))}%`}></span>
            </div>
            <p class="sub">{rupiah(spendingPlan)} planned out of {rupiah(incomePlan)} expected each month{spendShare > 1 ? ` · ${rupiah(spendingPlan - incomePlan)} more than the income` : ''}</p>
          </div>
        </section>
      )
    }

    <section class="block">
      <div class="block-head">
        <h2>Lines</h2>
        <span class="budget-actions">
          {previousYearLines > 0 && <button type="button" class="btn" data-copy>Copy from {year - 1}</button>}
          <button type="button" class="btn btn-solid" data-add>Add a line</button>
        </span>
      </div>
      {
        groups.length ? (
          <div class="budget-groups">
            {groups.map((g) => (
              <div class="budget-group">
                <div class="budget-group-head">
                  <span class="name" style="font-size: var(--text-body)">{g.title}</span>
                  <span class="tag">{g.income ? 'income' : 'spending'}</span>
                  <span class="num">{rupiah(g.total)} / month{!g.income && spendShare !== null ? ` · ${percent(shareOfIncome(g.total)!, 1)} of income` : ''}</span>
                </div>
                <div class="ruled">
                  {g.lines.map((b) => (
                    <div class="row row-budget">
                      <span>{b.nama_pos}{g.income && categoryName.get(b.kategori) !== b.nama_pos ? <span class="sub"> · {categoryName.get(b.kategori)}</span> : ''}</span>
                      <span class="num">{rupiah(amountOf(b))}</span>
                      <span class="num sub">{!g.income && incomePlan > 0 ? `${percent(amountOf(b) / incomePlan, 1)} of income` : ''}</span>
                      <span class="row-actions">
                        <button type="button" class="arrow-link" data-edit data-id={b.id} data-kategori={b.kategori} data-name={b.nama_pos} data-amount={amountOf(b)}>edit</button>
                        <button type="button" class="arrow-link danger" data-delete data-id={b.id} data-name={b.nama_pos}>delete</button>
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty">
            {loaded ? `No budget lines for ${year} yet.${previousYearLines ? ` Copy ${year - 1}'s lines or add a new one.` : ' Add the first one.'}` : 'The budgets are unavailable.'}
          </p>
        )
      }
    </section>

    {
      unbudgeted.length > 0 && budgets.length > 0 && (
        <p class="label muted">
          Spending categories without a budget in {year}: {unbudgeted.map((c) => c.nama).join(', ')}.
        </p>
      )
    }
    <p class="label muted">
      A budget is an amount per month. Several lines can share a category (for example Internet and Electricity under Bills); the dashboard compares their sum with what was spent in that category.
      A line on an income category, such as salary, is an expected income, not a limit.
    </p>

    <dialog class="dlg" id="budget-dialog" aria-labelledby="budget-dialog-title">
      <form method="dialog" data-budget-form novalidate>
        <h2 id="budget-dialog-title">Add a line</h2>
        <label class="dlg-field">
          <span class="label muted">Category</span>
          <select name="kategori" required>
            <option value="">Choose…</option>
            <optgroup label="Spending">
              {categories.filter((c) => c.jenis === 'pengeluaran').map((c) => <option value={c.id} data-inactive={c.aktif ? undefined : ''} disabled={!c.aktif} hidden={!c.aktif}>{c.nama}</option>)}
            </optgroup>
            <optgroup label="Income">
              {categories.filter((c) => c.jenis === 'pemasukan').map((c) => <option value={c.id} data-inactive={c.aktif ? undefined : ''} disabled={!c.aktif} hidden={!c.aktif}>{c.nama}</option>)}
            </optgroup>
          </select>
        </label>
        <label class="dlg-field">
          <span class="label muted">Name</span>
          <input name="nama_pos" type="text" maxlength="80" autocomplete="off" placeholder="e.g. Internet Rumah" required />
        </label>
        <label class="dlg-field">
          <span class="label muted">Amount per month (Rp)</span>
          <input name="jumlah" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 300.000" required />
        </label>
        <p class="dlg-error" data-budget-error role="alert"></p>
        <div class="dlg-actions">
          <button type="button" class="btn" data-cancel>Cancel</button>
          <button type="submit" class="btn btn-solid" data-save>Save</button>
        </div>
      </form>
    </dialog>
  </div>
</HermesShell>

<script>
  import '../../scripts/hermes-budgets';
</script>

<style is:global>
  .budget-actions {
    display: inline-flex;
    gap: var(--s-15);
    flex-wrap: wrap;
  }

  .budget-groups {
    display: grid;
    gap: var(--s-33);
  }

  .budget-group-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-15);
    flex-wrap: wrap;
  }

  .budget-group-head .num {
    margin-left: auto;
  }

  .row-budget {
    grid-template-columns: minmax(160px, 3fr) minmax(120px, 1.2fr) minmax(90px, 1fr) 130px;
    padding-block: 10px;
    align-items: baseline;
  }

  .row-budget .row-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-15);
  }

  @media (max-width: 720px) {
    .row-budget {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .row-budget > :first-child {
      grid-column: 1 / -1;
    }

    .row-budget .num {
      text-align: left;
    }

    .row-budget .num:nth-child(2) {
      grid-column: 1;
    }

    .row-budget .row-actions {
      grid-column: 2;
      grid-row: 2 / span 2;
    }

    .budget-group-head .num {
      margin-left: 0;
      flex-basis: 100%;
      text-align: left;
    }
  }

  .arrow-link.danger {
    color: var(--te-orange);
  }

  .row-actions button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: var(--text-caption);
    cursor: pointer;
  }
</style>
