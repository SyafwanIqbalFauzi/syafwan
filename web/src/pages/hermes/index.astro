---
import HermesShell from '../../layouts/HermesShell.astro';
import StatusTag from '../../components/StatusTag.astro';
import { readItems, type AgentJob, type AgentRun } from '../../lib/directus-user';
import { hermesGet } from '../../lib/hermes';
import { compact, formatWhen, relative } from '../../lib/format';
import { humanizeSchedule } from '../../lib/schedule';

export const prerender = false;

const token = Astro.locals.hermesToken!;
const weekAgo = new Date(Date.now() - 7 * 86_400_000).toISOString();

const [health, jobsResult, failedResult, recentResult] = await Promise.all([
  hermesGet<Record<string, any>>('/health/detailed'),
  readItems<AgentJob>(token, 'agent_jobs', { limit: -1 }).catch(() => null),
  readItems<Omit<AgentRun, 'response_md'>>(token, 'agent_runs', {
    'filter[status][_eq]': 'failed',
    'filter[started_at][_gte]': weekAgo,
    sort: '-started_at',
    limit: 10,
    fields: 'execution_id,job_id,job_name,started_at,error,summary',
  }).catch(() => null),
  readItems<Omit<AgentRun, 'response_md'>>(token, 'agent_runs', {
    'filter[status][_eq]': 'completed',
    'filter[kind][_eq]': 'agent',
    sort: '-started_at',
    limit: 8,
    fields: 'execution_id,job_id,job_name,started_at,duration_s,summary',
  }).catch(() => null),
]);

const jobs = (jobsResult?.data ?? []).filter((j) => j.state !== 'removed');
const upcoming = jobs
  .filter((j) => j.enabled && j.state === 'scheduled' && j.next_run_at && new Date(j.next_run_at).getFullYear() < 2030)
  .sort((a, b) => a.next_run_at!.localeCompare(b.next_run_at!))
  .slice(0, 6);
const failed = failedResult?.data ?? [];
const recent = recentResult?.data ?? [];

const checks = health?.readiness?.checks ?? {};
const platforms: [string, string][] = Object.entries(health?.platforms ?? {}).map(([name, p]: [string, any]) => [name, p?.state ?? 'unknown']);
const counts = {
  active: jobs.filter((j) => j.enabled && j.state === 'scheduled').length,
  paused: jobs.filter((j) => j.state === 'paused' || (j.enabled === false && j.state !== 'completed')).length,
};
---

<HermesShell title="Overview" current="overview">
  <div class="container page">
    <div class="page-head">
      <h1 class="h1">Overview</h1>
      <p class="label muted">{health ? `Hermes ${health.version} · gateway ${health.gateway_state}` : 'Hermes is unreachable'}</p>
    </div>

    {!health && <p class="notice error" role="alert">Could not reach the Hermes API. Saved history below is still available.</p>}

    <section class="block" id="health">
      <div class="block-head"><h2>Health</h2></div>
      <div class="figures">
        <div class="figure"><p class="value">{health?.active_agents ?? '—'}</p><p class="label">agents working now</p></div>
        <div class="figure"><p class="value">{counts.active}</p><p class="label">scheduled · {counts.paused} paused</p></div>
        <div class="figure"><p class="value">{checks.disk?.used_percent !== undefined ? `${Math.round(checks.disk.used_percent)}%` : '—'}</p><p class="label">disk used</p></div>
        <div class="figure"><p class="value">{compact(health?.metrics_today?.tokens)}</p><p class="label">web-chat tokens today</p></div>
      </div>
      {
        platforms.length > 0 && (
          <p class="chips" style="margin-top: 15px">
            {platforms.map(([name, state]) => <StatusTag status={state} label={`${name}: ${state}`} />)}
          </p>
        )
      }
    </section>

    <section class="block" id="failures">
      <div class="block-head">
        <h2>Failures</h2>
        <p class="label muted">last 7 days</p>
      </div>
      {
        failed.length ? (
          <div class="ruled">
            {failed.map((run) => (
              <a class="row row-feed row-link" href={`/hermes/agents/${run.job_id}?run=${run.execution_id}#result`}>
                <span>{formatWhen(run.started_at)}<br /><span class="sub">{relative(run.started_at)}</span></span>
                <span><StatusTag status="failed" /></span>
                <span class="name" style="font-size: var(--text-body)">{run.job_name}</span>
                <span class="snippet">{run.error ?? run.summary ?? ''}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">{failedResult ? 'No failed runs in the last 7 days.' : 'Run history is unavailable.'}</p>
        )
      }
    </section>

    <section class="block" id="upcoming">
      <div class="block-head">
        <h2>Upcoming</h2>
        <a class="arrow-link" href="/hermes/agents?state=active">all agents</a>
      </div>
      {
        upcoming.length ? (
          <div class="ruled">
            {upcoming.map((job) => (
              <a class="row row-feed row-link" href={`/hermes/agents/${job.job_id}`}>
                <span>{formatWhen(job.next_run_at)}<br /><span class="sub">{relative(job.next_run_at)}</span></span>
                <span><span class="tag">{job.kind === 'script' ? 'script' : 'ai'}</span></span>
                <span></span>
                <span><span class="name" style="font-size: var(--text-body)">{job.name}</span><br /><span class="sub">{humanizeSchedule(job.schedule_display)}</span></span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">Nothing scheduled.</p>
        )
      }
    </section>

    <section class="block">
      <div class="block-head"><h2>Latest results</h2><p class="label muted">ai agents only</p></div>
      {
        recent.length ? (
          <div class="ruled">
            {recent.map((run) => (
              <a class="row row-feed row-link" href={`/hermes/agents/${run.job_id}?run=${run.execution_id}#result`}>
                <span>{formatWhen(run.started_at)}<br /><span class="sub">{relative(run.started_at)}</span></span>
                <span><StatusTag status="completed" label="done" /></span>
                <span class="name" style="font-size: var(--text-body)">{run.job_name}</span>
                <span class="snippet">{run.summary ?? ''}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">No results saved yet.</p>
        )
      }
    </section>
  </div>
</HermesShell>
