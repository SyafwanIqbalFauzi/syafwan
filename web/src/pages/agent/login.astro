---
import HermesShell from '../../layouts/HermesShell.astro';
import { audit, login, setSession } from '../../lib/auth';
import { RateLimiter } from '../../lib/ratelimit';
import { safeNext } from '../../lib/next-path';

export const prerender = false;

// 5 attempts a minute per client. Behind the host gateway all visitors may share one
// address, which only makes the limit stricter, never looser.
const limiter = ((globalThis as any).__hermesLoginLimiter ??= new RateLimiter(5, 60_000)) as RateLimiter;

const secure = (Astro.site ?? new URL(Astro.url.origin)).protocol === 'https:';
let error = '';
// The authenticator field only appears when Directus says this account has 2FA on.
let needsOtp = false;
let emailValue = '';
// Where to go after signing in: the page that sent the person here (only our own private pages).
const next = safeNext(Astro.request.method === 'POST' ? (await Astro.request.clone().formData()).get('next') : Astro.url.searchParams.get('next'));

if (Astro.request.method === 'POST') {
  const ip = Astro.request.headers.get('x-forwarded-for')?.split(',').pop()?.trim() || Astro.clientAddress || 'unknown';
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().slice(0, 254);
  const password = String(form.get('password') ?? '').slice(0, 512);
  const otp = String(form.get('otp') ?? '').replace(/\s/g, '').slice(0, 12);
  emailValue = email;

  if (!limiter.take(ip)) {
    audit('login_throttled', { ip });
    Astro.response.status = 429;
    error = 'Too many attempts. Try again in a minute.';
  } else if (!email || !password) {
    error = 'Enter your email and password.';
  } else {
    const result = await login(email, password, otp);
    if (result.ok) {
      limiter.reset(ip);
      setSession(Astro.cookies, result.tokens, secure);
      audit('login', { user: result.user.email, ip });
      return Astro.redirect(next, 303);
    }
    audit('login_failed', { email, ip, reason: result.reason });
    needsOtp = result.reason === 'otp';
    Astro.response.status = result.reason === 'unavailable' ? 503 : 401;
    error =
      result.reason === 'unavailable'
        ? 'Sign-in is temporarily unavailable.'
        : result.reason === 'otp'
          ? otp
            ? 'That authenticator code was not accepted. Wait for a fresh code and try again; if it keeps failing, check this computer’s clock.'
            : 'This account uses two-step verification. Enter your password again together with the 6-digit code from your authenticator app.'
          : 'Invalid credentials.';
  }
}
---

<HermesShell title="Sign in" bare>
  <div class="container signin">
    <form method="post" autocomplete="on">
      <input type="hidden" name="next" value={next} />
      <p class="label muted">private area</p>
      <h1 class="h1">Sign in</h1>
      {error && <p class="notice error" role="alert">{error}</p>}
      <label>
        <span class="label muted">Email</span>
        <input type="email" name="email" autocomplete="username" value={emailValue} required autofocus={!needsOtp} />
      </label>
      <label>
        <span class="label muted">Password</span>
        <input type="password" name="password" autocomplete="current-password" required />
      </label>
      {
        needsOtp && (
          <label>
            <span class="label muted">Authenticator code</span>
            <input type="text" name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="12" placeholder="000000" required autofocus />
          </label>
        )
      }
      <button type="submit" class="btn btn-solid">sign in</button>
    </form>
  </div>
</HermesShell>

<style is:global>
  .signin {
    padding-block: var(--s-66);
    display: flex;
    justify-content: center;
  }
  .signin form {
    width: 100%;
    max-width: 380px;
    display: grid;
    gap: var(--s-15);
  }
  .signin .h1 {
    font-weight: var(--w-thin);
  }
  .signin label {
    display: grid;
    gap: var(--s-4);
  }
  .signin input {
    font: inherit;
    font-size: var(--text-body);
    color: var(--te-black);
    background: var(--te-white);
    border: 1px solid var(--te-grey-200);
    border-radius: 0;
    padding: var(--s-11);
  }
  .signin input:focus-visible {
    outline: 1px solid var(--te-black);
    outline-offset: 0;
  }
  .signin .btn {
    justify-content: center;
    padding: var(--s-11) var(--s-15);
  }
</style>
