---
import HermesShell from '../../layouts/HermesShell.astro';

export const prerender = false;
---

<HermesShell title="Chat" current="chat" fill>
  <div class="chat">
    <aside class="side" aria-label="Sessions">
      <button id="new-chat" type="button" class="btn btn-solid">new chat</button>
      <ul id="sessions" class="ruled"></ul>
      <p class="label muted">web chats and your Telegram / Discord conversations. <a class="link" href="/agent/sessions">all sessions</a></p>
    </aside>

    <section class="pane">
      <header class="pane-head">
        <button id="chats-toggle" class="btn chats-btn" type="button" aria-expanded="false" aria-controls="sessions">chats</button>
        <h1 id="title" class="chat-title" title="Click to rename this chat">New chat</h1>
        <button id="rename-title" class="act" type="button" hidden aria-label="Rename this chat">rename</button>
        <span id="status" class="label muted" role="status"></span>
      </header>
      <div id="log" aria-live="polite"></div>
      <form id="composer">
        <label class="visually-hidden" for="input">Message Hermes</label>
        <ul id="attachments" class="attachments" aria-label="Attached images" hidden></ul>
        <textarea id="input" rows="2" placeholder="Message Hermes (Enter to send, Shift+Enter for a new line, Ctrl+V to paste an image)" autofocus></textarea>
        <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden />
        <button id="attach" type="button" class="btn" aria-label="Attach an image" title="Attach an image (or paste / drop one)">image</button>
        <button id="send" type="submit" class="btn btn-solid">send</button>
        <button id="stop" type="button" class="btn btn-stop" hidden>stop</button>
      </form>
    </section>
  </div>
</HermesShell>

<script>
  import '../../scripts/hermes-chat';
</script>

<style is:global>
  .chat {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
  }

  .chat .side {
    display: flex;
    flex-direction: column;
    gap: var(--s-15);
    padding: var(--s-15) var(--gutter);
    border-right: 1px solid var(--te-grey-100);
    min-height: 0;
  }

  .chat #sessions {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  .chat #sessions li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .chat #sessions li.active {
    background: var(--te-white);
    box-shadow: inset 2px 0 0 var(--te-black);
  }

  .chat #sessions .open {
    flex: 1;
    min-width: 0;
    text-align: left;
    padding: 10px 8px;
    font-size: var(--text-caption);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat #sessions .open:hover,
  .chat #sessions .mini:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chat #sessions .run-flag {
    flex: none;
    padding: 1px 6px;
    font-size: 11px;
    line-height: 1.3;
    border: 1px solid var(--te-amber);
    background: var(--te-amber);
    color: var(--te-black);
    animation: run-flag-pulse 1.6s ease-in-out infinite;
  }

  @keyframes run-flag-pulse {
    50% {
      opacity: 0.55;
    }
  }

  .chat #sessions .run-flag[data-state='done'] {
    animation: none;
    background: var(--te-page);
    border-color: var(--te-black);
  }

  .chat #sessions .run-flag[data-state='wait'] {
    animation: none;
    background: var(--te-black);
    border-color: var(--te-black);
    color: var(--te-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .chat #sessions .run-flag {
      animation: none;
    }
  }

  .chat #sessions .mini {
    font-size: 11px;
    color: var(--te-grey-600);
    padding: 4px;
  }

  .chat .pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .pane-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-15);
    padding: var(--s-15) var(--gutter);
    border-bottom: 1px solid var(--te-grey-100);
  }

  .chat-title[data-editable='true'] {
    cursor: text;
  }

  .chat-title[data-editable='true']:hover {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }

  .title-input {
    width: min(560px, 100%);
    font: inherit;
    color: inherit;
    background: var(--te-white);
    border: 1px solid var(--te-black);
    border-radius: 0;
    padding: 2px 8px;
  }

  .title-input:focus-visible {
    outline: none;
  }

  .chat-title {
    font-size: var(--text-sub);
    font-weight: var(--w-light);
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--s-22) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--s-15);
  }

  /* "Hermes is working" line at the end of the conversation */
  .typing {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 780px;
    padding: 6px 14px;
    font-size: var(--text-caption);
    color: var(--te-grey-600);
    border-left: 1px solid var(--te-black);
  }

  .typing.wait {
    border-left: 3px solid var(--te-amber);
    color: var(--te-black);
    background: var(--te-white);
  }

  .typing .dots {
    display: inline-flex;
    gap: 4px;
  }

  .typing .dots i {
    width: 6px;
    height: 6px;
    background: currentColor;
    animation: typing-pulse 1.2s infinite ease-in-out both;
  }

  .typing .dots i:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing .dots i:nth-child(3) {
    animation-delay: 0.4s;
  }

  .typing.wait .dots {
    display: none;
  }

  .typing .typing-text {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .typing .typing-time {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    color: var(--te-grey-300);
  }

  @keyframes typing-pulse {
    0%,
    80%,
    100% {
      opacity: 0.2;
    }
    40% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing .dots i {
      animation: none;
      opacity: 0.6;
    }
  }

  /* The answer bubble stays hidden until the first words arrive (the indicator covers that time). */
  .msg.assistant:has(> .body:empty) {
    display: none;
  }

  /* #log is a column flex box with a fixed height. Anything with overflow set (the tool cards,
     code blocks) has a computed minimum height of 0, so once the conversation is long the browser
     would squash them into thin strips and clip their text. Nothing in the log may shrink. */
  #log > * {
    flex-shrink: 0;
  }

  .msg {
    max-width: 780px;
  }

  .msg.user {
    align-self: flex-end;
  }

  .msg .body {
    padding: 12px 14px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .msg.user .body {
    background: var(--te-white);
    white-space: pre-wrap;
  }

  .msg.assistant .body {
    border-left: 1px solid var(--te-grey-200);
  }

  .msg.assistant .body.streaming {
    white-space: pre-wrap;
    border-left-color: var(--te-black);
  }

  .msg .body.error {
    border-left: 3px solid var(--te-orange);
  }

  .msg .body p + p,
  .msg .body ul,
  .msg .body ol,
  .msg .body pre {
    margin-top: 0.7em;
  }

  .msg .body ul,
  .msg .body ol {
    padding-left: 1.2em;
    list-style: revert;
  }

  .msg .body a {
    color: var(--te-blue);
    overflow-wrap: anywhere;
  }

  .msg .body pre,
  .tool,
  .approval pre {
    background: var(--te-carbon);
    color: var(--te-white);
    padding: 12px;
    font-size: 13px;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .tool {
    max-width: 780px;
    padding: 6px 10px;
    border-left: 3px solid var(--te-grey-600);
  }

  .tool strong {
    font-weight: var(--w-regular);
  }

  .tool.running {
    border-left-color: var(--te-amber);
  }

  .tool.failed {
    border-left-color: var(--te-orange);
  }

  .approval {
    max-width: 780px;
    border: 1px solid var(--te-amber);
    padding: 12px 14px;
  }

  .approval pre {
    margin: 8px 0;
  }

  .approval .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .approval .choices button {
    font-size: var(--text-caption);
    font-weight: var(--w-regular);
    padding: 8px 14px;
    border: 1px solid var(--te-black);
  }

  .approval .choices button:hover:not(:disabled) {
    background: var(--te-black);
    color: var(--te-white);
  }

  .approval .choices button.deny {
    border-color: var(--te-orange);
    color: var(--te-orange);
  }

  .hint {
    color: var(--te-grey-600);
    font-size: var(--text-caption);
  }

  #composer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: var(--s-15) var(--gutter);
    border-top: 1px solid var(--te-grey-100);
  }

  #composer textarea {
    flex: 1;
    font: inherit;
    font-size: var(--text-body);
    resize: none;
    background: var(--te-white);
    border: 1px solid var(--te-grey-200);
    border-radius: 0;
    padding: 10px 12px;
  }

  #composer.dragging textarea {
    outline: 2px dashed var(--te-black);
    outline-offset: -2px;
  }

  .attachments {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .attachments[hidden] {
    display: none;
  }

  .attachments li {
    position: relative;
    width: 72px;
    height: 72px;
    border: 1px solid var(--te-grey-200);
    background: var(--te-white);
  }

  .attachments img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .attachments button {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 20px;
    height: 20px;
    padding: 0;
    line-height: 1;
    font: inherit;
    cursor: pointer;
    background: var(--te-black);
    color: var(--te-white);
    border: 0;
    border-radius: 50%;
  }

  .msg .body .pics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .msg .body .pics img {
    max-width: min(100%, 320px);
    max-height: 260px;
    object-fit: contain;
    border: 1px solid var(--te-grey-200);
    background: var(--te-white);
    cursor: zoom-in;
  }

  #composer textarea:focus-visible {
    outline: 1px solid var(--te-black);
    outline-offset: 0;
  }

  .btn-stop {
    background: var(--te-orange);
    border-color: var(--te-orange);
    color: var(--te-white);
  }

  .btn-stop:hover {
    background: var(--te-black);
    border-color: var(--te-black);
  }

  .chats-btn {
    display: none;
  }

  /* Phone: one screen at a time. The conversation fills the screen; "chats" swaps it for the list
     of conversations (like a messenger), and opening one swaps back. */
  @media (max-width: 800px) {
    .chat {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .chat .side {
      display: none;
      border-right: 0;
      padding-top: var(--s-15);
    }

    .chat.show-sessions .side {
      display: flex;
    }

    .chat.show-sessions .pane {
      display: none;
    }

    .chats-btn {
      display: inline-flex;
      align-self: center;
      min-height: 40px;
      flex: none;
    }

    .pane-head {
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      padding-block: 10px;
    }

    .chat-title {
      flex: 1;
      min-width: 0;
      font-size: var(--text-body);
    }

    .chat #sessions .open {
      padding-block: 14px;
    }

    .chat #sessions .mini {
      min-height: 44px;
      padding-inline: 8px;
    }

    #log {
      padding-block: var(--s-15);
    }

    .msg {
      max-width: 100%;
    }

    .msg.user {
      max-width: 92%;
    }

    #composer {
      gap: 8px;
      padding-bottom: max(var(--s-15), env(safe-area-inset-bottom));
    }

    #composer textarea {
      flex-basis: 100%;
      font-size: 16px;
    }

    #composer .btn {
      flex: 1;
      justify-content: center;
      min-height: 46px;
    }

    #composer #send,
    #composer #stop {
      flex: 2;
    }
  }
</style>
