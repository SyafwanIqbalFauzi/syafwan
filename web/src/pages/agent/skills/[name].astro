---
import HermesShell from '../../../layouts/HermesShell.astro';
import StatusTag from '../../../components/StatusTag.astro';
import { readItem, readItems, type AgentJob, type AgentSkill, type SkillChange } from '../../../lib/directus-user';
import { formatWhen, relative } from '../../../lib/format';
import { renderMarkdown } from '../../../lib/markdown';
import { SKILL_NAME, usageMap } from '../../../lib/skills';

export const prerender = false;

const { name } = Astro.params;
if (!name || !SKILL_NAME.test(name)) return Astro.rewrite('/404');

const token = Astro.locals.hermesToken!;
let skill: AgentSkill | null = null;
let jobs: AgentJob[] = [];
let changes: SkillChange[] = [];
let problem = '';
try {
  skill = await readItem<AgentSkill>(token, 'agent_skills', { 'filter[name][_eq]': name });
  jobs = (await readItems<AgentJob>(token, 'agent_jobs', { limit: -1, sort: 'name' })).data.filter((j) => j.state !== 'removed');
} catch {
  problem = 'Could not read this skill from Directus.';
}
if (!skill && !problem) return Astro.rewrite('/404');
try {
  changes = (
    await readItems<SkillChange>(token, 'skill_changes', {
      'filter[skill][_eq]': name,
      sort: '-requested_at',
      limit: 5,
      fields: 'id,skill,action,status,requested_by,requested_at,applied_at,result',
    })
  ).data;
} catch {
  /* the history is optional */
}

const users = usageMap(jobs).get(name) ?? [];
const usingIds = new Set(users.map((u) => u.job_id));
// Only AI agents can use skills, and only those that do not already have this one.
const candidates = jobs.filter((j) => j.kind === 'agent' && !usingIds.has(j.job_id) && j.state !== 'completed');
const removed = skill?.source === 'removed';
const canAttach = Boolean(skill) && !removed && skill?.enabled !== false;
---

<HermesShell title={name} current="skills">
  <div class="container page">
    <p class="label muted crumb"><a class="link" href="/agent/skills">← skills</a></p>
    <div class="page-head">
      <h1 class="h1">{name}</h1>
      <div class="chips">
        {skill && <span class="tag">{skill.source === 'builtin' ? 'built-in' : skill.source === 'removed' ? 'removed' : 'yours'}</span>}
        {skill?.enabled === false && <StatusTag status="paused" label="disabled" />}
        {skill?.essential && <span class="tag tag-idle">essential</span>}
      </div>
    </div>

    {problem && <p class="notice error" role="alert">{problem}</p>}
    <p class="notice" data-change-banner role="status" hidden></p>
    {removed && <p class="notice">This skill no longer exists in Hermes. Its last synced text is shown below.</p>}

    {
      skill && (
        <>
          <p class="skill-desc">{skill.description}</p>

          {
            !removed && (
              <div class="actions" style="margin-bottom: var(--s-22)">
                {skill.essential ? (
                  <span class="label muted">Essential for Hermes: cannot be disabled.</span>
                ) : (
                  <button type="button" class="btn" data-toggle data-skill={name} data-enabled={skill.enabled === false ? 'false' : 'true'} data-users={JSON.stringify(users.map((u) => u.name))}>
                    {skill.enabled === false ? 'enable skill' : 'disable skill'}
                  </button>
                )}
                {!skill.essential && <span class="label muted">Hermes applies this within a couple of minutes; agents use it from their next run.</span>}
              </div>
            )
          }

          <section class="block">
            <div class="ruled">
              <div class="row row-kv"><span class="muted">category</span><span>{skill.category}</span></div>
              {skill.version && <div class="row row-kv"><span class="muted">version</span><span>{skill.version}</span></div>}
              <div class="row row-kv"><span class="muted">files</span><span>{skill.files ?? 1}</span></div>
              <div class="row row-kv"><span class="muted">synced</span><span>{formatWhen(skill.synced_at)} ({relative(skill.synced_at)})</span></div>
            </div>
          </section>

          <section class="block">
            <div class="block-head">
              <h2>Used by</h2>
              <p class="label muted">{users.length} {users.length === 1 ? 'agent' : 'agents'}</p>
            </div>
            <div class="ruled" data-skill={name}>
              {
                users.map((u) => (
                  <div class="row row-use">
                    <a class="name" style="font-size: var(--text-body)" href={`/agent/agents/${u.job_id}`}>{u.name}</a>
                    <button type="button" class="act danger" data-assign="remove" data-job={u.job_id} data-job-name={u.name}>remove</button>
                  </div>
                ))
              }
              {!users.length && <p class="empty">No agent uses this skill.</p>}
            </div>

            {
              canAttach && candidates.length > 0 && (
                <form class="attach-form" data-attach data-skill={name}>
                  <label class="visually-hidden" for="attach-job">Add to agent</label>
                  <select id="attach-job" name="job" class="fb-select">
                    <option value="">Add to an agent…</option>
                    {candidates.map((j) => <option value={j.job_id} data-name={j.name}>{j.name}</option>)}
                  </select>
                  <button type="submit" class="btn btn-solid">add</button>
                  <span class="label muted" data-assign-status role="status"></span>
                </form>
              )
            }
            {!canAttach && !removed && <p class="label muted" style="margin-top: var(--s-11)">Disabled skills cannot be added to agents.</p>}
          </section>

          <section class="block">
            <div class="block-head">
              <h2>Instructions</h2>
              <p class="label muted">SKILL.md · secrets, long ids and credential paths are hidden</p>
            </div>
            {
              skill.editable ? (
                <details class="edit-box" id="editor">
                  <summary class="act">edit instructions</summary>
                  <form class="editor-form" data-editor data-skill={name} data-base-hash={skill.body_hash}>
                    <p class="label muted">
                      You are editing a copy in which secrets, long ids and credential paths are hidden. Lines that contain a hidden value
                      (shown as <code>[id hidden]</code> or <code>credentials/[hidden]</code>) cannot be changed or removed here; every other
                      line can. Hermes keeps the previous version as a backup.
                    </p>
                    <label class="visually-hidden" for="skill-text">Instructions</label>
                    <textarea id="skill-text" name="content" rows="26" spellcheck="false" maxlength="60000" required>{skill.content_md}</textarea>
                    <div class="sf-actions">
                      <button type="submit" class="btn btn-solid">save changes</button>
                      <button type="button" class="act" data-undo>undo my edits</button>
                      <span class="label muted" data-editor-status role="status"></span>
                    </div>
                  </form>
                </details>
              ) : (
                !removed && <p class="label muted" style="margin-bottom: var(--s-15)">{skill.source === 'builtin' ? 'Built-in skills are read-only here.' : 'This skill cannot be edited safely from the website.'}</p>
              )
            }
            {skill.content_md ? <div class="skill-body prose prose-compact" set:html={renderMarkdown(skill.content_md)} /> : <p class="empty">This skill has no text.</p>}
          </section>

          {
            changes.length > 0 && (
              <section class="block">
                <div class="block-head"><h2>Recent changes</h2><p class="label muted">made from this website</p></div>
                <div class="ruled">
                  {changes.map((c) => (
                    <div class="row row-change">
                      <span>{formatWhen(c.requested_at)}</span>
                      <span>{c.action === 'set_enabled' ? 'enable / disable' : 'edit instructions'}</span>
                      <span><StatusTag status={c.status === 'applied' ? 'completed' : c.status === 'pending' ? 'paused' : 'failed'} label={c.status} /></span>
                      <span class="sub">{c.result ?? (c.status === 'pending' ? 'waiting for Hermes…' : '')}</span>
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </>
      )
    }
  </div>
</HermesShell>

<script>
  import '../../../scripts/hermes-skill-assign';
  import '../../../scripts/hermes-skill-manage';
</script>

<style is:global>
  .row-change {
    grid-template-columns: 150px 150px 110px 1fr;
    padding-block: var(--s-11);
  }
  @media (max-width: 900px) {
    .row-change {
      grid-template-columns: 1fr 1fr;
    }
  }
  .editor-form {
    display: grid;
    gap: var(--s-15);
    margin-top: var(--s-15);
  }
  .editor-form textarea {
    width: 100%;
    min-height: 420px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 1.5;
    tab-size: 2;
    background: var(--te-page);
    border: 1px solid var(--te-grey-200);
    border-radius: 0;
    padding: var(--s-11);
    resize: vertical;
  }
  .editor-form textarea:focus-visible {
    outline: 1px solid var(--te-black);
    outline-offset: 0;
  }
  .skill-desc {
    max-width: 760px;
    margin-bottom: var(--s-22);
    font-size: var(--text-sub);
    font-weight: var(--w-light);
    line-height: 1.4;
  }
  .row-use {
    grid-template-columns: 1fr auto;
    align-items: center;
  }
  .attach-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8) var(--s-15);
    align-items: center;
    margin-top: var(--s-15);
  }
  .attach-form .fb-select {
    min-width: 280px;
  }
  .skill-body {
    border: 1px solid var(--te-grey-100);
    padding: var(--s-22);
    max-width: 920px;
  }
  .skill-body pre {
    background: var(--te-carbon);
    color: var(--te-white);
    padding: var(--s-15);
    overflow-x: auto;
    font-size: 13px;
  }
  .skill-body table {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .skill-body th,
  .skill-body td {
    border: 1px solid var(--te-grey-100);
    padding: var(--s-4) var(--s-11);
    font-size: var(--text-caption);
  }
</style>
