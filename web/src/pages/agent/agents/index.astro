---
import HermesShell from '../../../layouts/HermesShell.astro';
import FilterBar from '../../../components/FilterBar.astro';
import StatusTag from '../../../components/StatusTag.astro';
import { readItems, type AgentJob, type AgentRun } from '../../../lib/directus-user';
import { compareJobs, parseSort, SORT_OPTIONS } from '../../../lib/agent-sort';
import { formatWhen, modelLabel, relative } from '../../../lib/format';
import { orderGroups, UNGROUPED } from '../../../lib/groups';
import { humanizeSchedule } from '../../../lib/schedule';

export const prerender = false;

const token = Astro.locals.hermesToken!;
const kind = Astro.url.searchParams.get('kind');
const state = Astro.url.searchParams.get('state');
const groupFilter = Astro.url.searchParams.get('group');
const sort = parseSort(Astro.url.searchParams.get('sort'));
const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();

let jobs: AgentJob[] = [];
const lastRun = new Map<string, Pick<AgentRun, 'job_id' | 'status' | 'started_at' | 'duration_s' | 'summary' | 'execution_id'>>();
let problem = '';
try {
  jobs = (await readItems<AgentJob>(token, 'agent_jobs', { limit: -1, sort: 'name' })).data.filter((j) => j.state !== 'removed');
  const runs = await readItems<AgentRun>(token, 'agent_runs', {
    limit: 600,
    sort: '-started_at',
    fields: 'job_id,status,started_at,duration_s,summary,execution_id',
  });
  for (const run of runs.data) if (!lastRun.has(run.job_id)) lastRun.set(run.job_id, run);
} catch {
  problem = 'Could not read the agent list from Directus.';
}

// Hermes' own last_status is authoritative: silent successful script ticks are not stored as runs,
// so the newest stored run can be older than (and disagree with) the job's real last result.
const lastStatusOf = (j: AgentJob) =>
  j.last_status ? (j.last_status === 'ok' ? 'completed' : 'failed') : (lastRun.get(j.job_id)?.status ?? null);
const lastTimeOf = (j: AgentJob) => j.last_run_at ?? lastRun.get(j.job_id)?.started_at ?? null;
const stateOf = (j: AgentJob): 'active' | 'paused' | 'done' => (j.state === 'completed' ? 'done' : j.state === 'paused' || j.enabled === false ? 'paused' : 'active');
const groupOf = (j: AgentJob) => j.agent_group || UNGROUPED;
const sortable = (j: AgentJob) => ({
  name: j.name,
  state: stateOf(j),
  next_run_at: stateOf(j) === 'active' ? j.next_run_at : null,
  last_run_at: lastTimeOf(j),
  failing: lastStatusOf(j) === 'failed',
});
const matches = (j: AgentJob) =>
  (!kind || j.kind === kind) &&
  (!state || stateOf(j) === state) &&
  (!groupFilter || groupOf(j) === groupFilter) &&
  (!q || `${j.name} ${(j.skills ?? []).join(' ')} ${j.model} ${groupOf(j)}`.toLowerCase().includes(q));

const shown = jobs.filter(matches).sort((a, b) => compareJobs(sort, sortable(a), sortable(b)));

// Sections, in a stable order; counts in the filter bar ignore the group filter itself.
const allGroups = orderGroups(jobs.map(groupOf));
const sections = orderGroups(shown.map(groupOf)).map((name) => {
  const items = shown.filter((j) => groupOf(j) === name);
  const active = items.filter((j) => stateOf(j) === 'active').length;
  const paused = items.filter((j) => stateOf(j) === 'paused').length;
  const failing = items.filter((j) => lastStatusOf(j) === 'failed').length;
  return { name, items, active, paused, failing };
});

const counts = { agent: jobs.filter((j) => j.kind === 'agent').length, script: jobs.filter((j) => j.kind === 'script').length };
const countIn = (name: string) => jobs.filter((j) => groupOf(j) === name).length;
const syncedAt = jobs.map((j) => j.synced_at).filter(Boolean).sort().at(-1);
---

<HermesShell title="Agents" current="agents">
  <div class="container page">
    <div class="page-head">
      <h1 class="h1">Agents</h1>
      <p class="label muted">
        {counts.agent} ai agents · {counts.script} scripts · {allGroups.length} groups{syncedAt ? ` · synced ${relative(syncedAt)}` : ''}
      </p>
    </div>

    {problem && <p class="notice error" role="alert">{problem}</p>}

    <FilterBar
      resetHref={Astro.url.pathname}
      selects={[
        { name: 'group', label: 'Group', value: groupFilter, all: `All groups (${jobs.length})`, options: allGroups.map((name) => ({ value: name, label: `${name} (${countIn(name)})` })) },
        { name: 'kind', label: 'Type', value: kind, all: 'All types', options: [{ value: 'agent', label: `AI agents (${counts.agent})` }, { value: 'script', label: `Scripts (${counts.script})` }] },
        { name: 'sort', label: 'Sort by', value: sort, all: 'Default (active first, next run)', options: [...SORT_OPTIONS] },
        { name: 'state', label: 'State', value: state, all: 'Any state', options: [{ value: 'active', label: 'Active' }, { value: 'paused', label: 'Paused' }, { value: 'done', label: 'Done' }] },
      ]}
      search={{ name: 'q', value: q, placeholder: 'name, skill or model' }}
    />

    {
      sections.map((section, index) => (
        <section class="block" id={`group-${section.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <div class="block-head">
            <h2>{section.name}</h2>
            <p class="label muted">
              {section.items.length} {section.items.length === 1 ? 'agent' : 'agents'} · {section.active} active
              {section.paused > 0 && ` · ${section.paused} paused`}
              {section.failing > 0 && ` · ${section.failing} failing`}
            </p>
          </div>
          <div class="ruled">
            {index === 0 && (
              <div class="row row-agent row-head" aria-hidden="true">
                <span>agent</span><span>schedule</span><span>last run</span><span>last result</span>
              </div>
            )}
            {section.items.map((job) => {
              const last = lastRun.get(job.job_id);
              const s = stateOf(job);
              return (
                <a class="row row-agent row-link" href={`/agent/agents/${job.job_id}`}>
                  <div>
                    <p class="name">{job.name}</p>
                    <div class="chips" style="margin-top: 6px">
                      <span class="tag">{job.kind === 'script' ? 'script' : 'ai'}</span>
                      {s !== 'active' && <StatusTag status={s === 'done' ? 'completed' : 'paused'} label={s === 'done' ? 'done' : 'paused'} />}
                      {job.kind === 'agent' && <span class="tag tag-idle">{modelLabel(job.model)}</span>}
                    </div>
                    {(job.skills ?? []).length > 0 && <p class="sub" style="margin-top: 6px">{(job.skills ?? []).join(', ')}</p>}
                  </div>
                  <div>
                    <p>{humanizeSchedule(job.schedule_display)}</p>
                    <p class="sub">{s === 'active' && job.next_run_at ? `next ${formatWhen(job.next_run_at)} (${relative(job.next_run_at)})` : '—'}</p>
                    <p class="sub">{(job.deliver_labels ?? ['local']).join(', ')}</p>
                  </div>
                  <div>
                    {lastStatusOf(job) ? <StatusTag status={lastStatusOf(job)} /> : <span class="tag tag-idle">no history</span>}
                    {lastTimeOf(job) && <p class="sub" style="margin-top: 6px">{formatWhen(lastTimeOf(job))} · {relative(lastTimeOf(job))}</p>}
                  </div>
                  <p class="snippet">{last?.summary ?? ''}</p>
                </a>
              );
            })}
          </div>
        </section>
      ))
    }
    {!sections.length && !problem && <p class="empty">No agents match.</p>}
  </div>
</HermesShell>
