---
import Layout from '../../../layouts/Layout.astro';
import Cover from '../../../components/Cover.astro';
import Icon from '../../../components/Icon.astro';
import { getProject, getProjects } from '../../../lib/content';
import { formatPeriod, formatYears, isLocale, pick, t } from '../../../lib/i18n';
import { renderMarkdown } from '../../../lib/markdown';
import { assetUrl } from '../../../lib/assets';

const { lang, slug } = Astro.params;
if (!isLocale(lang) || !slug) return Astro.rewrite('/404');
const locale = lang;

const [project, all] = await Promise.all([getProject(slug), getProjects()]);
if (!project) return Astro.rewrite('/404');

const { value: tr } = pick(project.translations, locale);
const index = all.findIndex((p) => p.slug === project.slug);
const prev = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
const experiences = (project.experiences ?? []).map((e) => e.experiences_id).filter(Boolean);

const meta = [
  { label: t(locale, 'meta.client'), value: project.client },
  { label: t(locale, 'meta.period'), value: formatYears(project, locale) },
  { label: t(locale, 'meta.type'), value: t(locale, `common.${project.type}`) },
  { label: t(locale, 'meta.platforms'), value: project.platforms?.join(', ') },
  { label: t(locale, 'meta.roles'), value: project.roles?.join(', ') },
].filter((m) => m.value);
---

<Layout
  locale={locale}
  title={project.title}
  description={tr?.summary}
  image={project.cover ? assetUrl(project.cover, 1200, 'jpg') : null}
  type="article"
>
  <section class="container head">
    <p class="label crumbs">
      <a href={`/${locale}/work`}>{t(locale, 'nav.work')}</a>
      <span class="muted">/</span>
      <span class="muted">{project.title}</span>
    </p>
    <div class="head-grid">
      <div class="title-block">
        <h1 class="h1">{project.title}</h1>
        {tr?.summary && <p class="summary">{tr.summary}</p>}
      </div>
      <dl class="meta ruled">
        {
          meta.map((m) => (
            <div>
              <dt class="label muted">{m.label}</dt>
              <dd>
                {m.value}
                {m.label === t(locale, 'meta.period') && project.is_ongoing && (
                  <span class="tag tag-amber">{t(locale, 'common.ongoing')}</span>
                )}
              </dd>
            </div>
          ))
        }
        {
          project.url && (
            <div>
              <dt class="label muted">{t(locale, 'meta.link')}</dt>
              <dd>
                <a href={project.url} class="link" target="_blank" rel="noopener noreferrer">
                  {project.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  {
    project.cover && (
      <section class="band-dark showcase">
        <div class="container">
          <Cover file={project.cover} alt={project.title} eager sizes="(min-width: 1200px) 1200px, 100vw" ratio="auto" fit="contain" />
        </div>
      </section>
    )
  }

  <section class="container body">
    <div class="prose" set:html={renderMarkdown(tr?.body)} />

    {
      experiences.length > 0 && (
        <aside class="built">
          <h2 class="label muted">{t(locale, 'work.builtWhileAt')}</h2>
          <ul class="ruled">
            {experiences.map((e) => (
              <li>
                <a href={`/${locale}/about#experience`} class="built-row">
                  <span>{e.company}</span>
                  <span class="label muted">
                    {pick(e.translations, locale).value?.role} · {formatPeriod(e.start_date, e.end_date, locale)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </section>

  <nav class="container pager ruled" aria-label="Projects">
    <div class="pager-inner">
      {
        prev ? (
          <a href={`/${locale}/work/${prev.slug}`} class="pager-link">
            <span class="label muted">← {t(locale, 'common.previous')}</span>
            <span>{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/${locale}/work/${next.slug}`} class="pager-link next">
            <span class="label muted">
              {t(locale, 'common.next')} <Icon name="arrow" size={12} />
            </span>
            <span>{next.title}</span>
          </a>
        )
      }
    </div>
  </nav>
</Layout>

<style>
  .head {
    padding-block: var(--s-33) var(--s-66);
  }

  .crumbs {
    display: flex;
    gap: 8px;
    margin-bottom: var(--s-33);
  }

  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .head-grid {
    display: grid;
    gap: var(--s-33);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: var(--s-22);
  }

  .summary {
    font-size: var(--text-sub);
    line-height: 1.45;
    max-width: 640px;
  }

  @media (min-width: 1000px) {
    .head-grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--s-66);
    }
  }

  .meta div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: var(--s-15);
    padding-block: 10px;
  }

  .meta dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .showcase {
    padding-block: var(--s-66);
  }

  .showcase :global(.cover) {
    max-height: 80vh;
    background: transparent;
  }

  .body {
    display: grid;
    gap: var(--s-66);
    padding-block: var(--s-66);
  }

  @media (min-width: 1000px) {
    .body {
      grid-template-columns: 2fr 1fr;
    }
  }

  .built h2 {
    margin-bottom: var(--s-15);
  }

  .built-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 12px;
  }

  .built-row:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pager {
    margin-bottom: var(--s-66);
  }

  .pager-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--s-22);
    padding-block: var(--s-22);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 45%;
  }

  .pager-link .label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-link:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
