---
// Privacy policy for the Autoplay Blocker extension. The Chrome Web Store listing points here, so keep the URL stable.
import Layout from '../../../../layouts/Layout.astro';
import { autoplayBlockerLegal, PRIVACY_UPDATED } from '../../../../lib/autoplay-blocker-legal';
import { isLocale, t } from '../../../../lib/i18n';

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.rewrite('/404');
const locale = lang;
const p = autoplayBlockerLegal[locale].privacy;
const updated = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${PRIVACY_UPDATED}T00:00:00Z`));
---

<Layout locale={locale} title={p.seoTitle} description={p.intro}>
  <section class="container head">
    <p class="label crumbs">
      <a href={`/${locale}/work`}>{t(locale, 'nav.work')}</a>
      <span class="muted">/</span>
      <a href={`/${locale}/work/autoplay-blocker`}>Autoplay Blocker</a>
      <span class="muted">/</span>
      <span class="muted">{p.title}</span>
    </p>
    <h1 class="h1">{p.title}</h1>
    <p class="label muted">{p.updatedLabel}: {updated}</p>
  </section>

  <section class="container body">
    <div class="prose">
      <p>{p.intro}</p>
      {
        p.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            {s.paragraphs?.map((text) => <p>{text}</p>)}
            {s.items && (
              <ul>
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </>
        ))
      }
    </div>
    <p class="links">
      <a class="arrow-link" href={`/${locale}/work/autoplay-blocker/report?kind=privacy`}>{p.reportLink} →</a>
      <a class="arrow-link" href={`/${locale}/work/autoplay-blocker`}>← {p.back}</a>
    </p>
  </section>
</Layout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-15);
    padding-block: var(--s-66) var(--s-33);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .body {
    padding-bottom: var(--s-66);
    max-width: 760px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-22);
    margin-top: var(--s-33);
  }
</style>
