---
import Layout from '../../../layouts/Layout.astro';
import ProjectGrid from '../../../components/ProjectGrid.astro';
import { getProjects } from '../../../lib/content';
import { isLocale, t } from '../../../lib/i18n';

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.rewrite('/404');
const locale = lang;

const typeParam = Astro.url.searchParams.get('type');
const type = typeParam === 'product' || typeParam === 'project' ? typeParam : undefined;
const all = await getProjects();
const projects = type ? all.filter((p) => p.type === type) : all;

const filters = [
  { value: undefined, label: t(locale, 'common.all'), count: all.length },
  { value: 'product', label: t(locale, 'common.product'), count: all.filter((p) => p.type === 'product').length },
  { value: 'project', label: t(locale, 'common.project'), count: all.filter((p) => p.type === 'project').length },
] as const;
---

<Layout locale={locale} title={t(locale, 'work.title')} description={t(locale, 'work.count', { n: all.length })}>
  <section class="container head">
    <h1 class="h1">{t(locale, 'work.title')}</h1>
    <p class="label muted">{t(locale, 'work.count', { n: all.length })}</p>
    <ul class="filters" aria-label="Filter">
      {
        filters.map((f) => (
          <li>
            <a
              href={f.value ? `?type=${f.value}` : `/${locale}/work`}
              class="label filter"
              aria-current={type === f.value ? 'true' : undefined}
            >
              {f.label} <span class="muted">{f.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="grid-wrap">
    <ProjectGrid projects={projects} locale={locale} eagerCount={3} headingLevel={2} />
  </section>
</Layout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-15);
    padding-block: var(--s-66) var(--s-33);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-top: var(--s-15);
  }

  .filter {
    display: inline-flex;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--te-grey-100);
  }

  .filter:hover {
    border-color: var(--te-black);
  }

  .filter[aria-current='true'] {
    background: var(--te-black);
    border-color: var(--te-black);
    color: var(--te-white);
    font-weight: var(--w-regular);
  }

  .filter[aria-current='true'] .muted {
    color: var(--te-grey-300);
  }

  .grid-wrap {
    padding-bottom: var(--s-66);
  }
</style>
