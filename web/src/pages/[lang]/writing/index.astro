---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { getPosts } from '../../../lib/content';
import { formatDate, isLocale, pick, t } from '../../../lib/i18n';

const { lang } = Astro.params;
if (!isLocale(lang)) return Astro.rewrite('/404');
const locale = lang;

const all = await getPosts();
const tags = [...new Set(all.flatMap((p) => p.tags ?? []))].sort();
const tagParam = Astro.url.searchParams.get('tag');
const tag = tagParam && tags.includes(tagParam) ? tagParam : null;
const posts = tag ? all.filter((p) => p.tags?.includes(tag)) : all;
---

<Layout locale={locale} title={t(locale, 'writing.title')} description={t(locale, 'writing.count', { n: all.length })}>
  <section class="container head">
    <h1 class="h1">{t(locale, 'writing.title')}</h1>
    <p class="label muted">{t(locale, 'writing.count', { n: all.length })}</p>
    <ul class="filters" aria-label="Tags">
      <li>
        <a href={`/${locale}/writing`} class="label filter" aria-current={!tag ? 'true' : undefined}>
          {t(locale, 'common.all')}
        </a>
      </li>
      {
        tags.map((name) => (
          <li>
            <a href={`?tag=${encodeURIComponent(name)}`} class="label filter" aria-current={tag === name ? 'true' : undefined}>
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container list-wrap">
    <ul class="ruled">
      {
        posts.map((post) => {
          const { value: tr, fallback } = pick(post.translations, locale);
          return (
            <li>
              <a href={`/${locale}/writing/${post.slug}`} class="post">
                <span class="label muted date">{formatDate(post.published_at, locale)}</span>
                <span class="main">
                  <span class="title">
                    {tr?.title}
                    {fallback && (
                      <span class="tag" title={t(locale, `common.writtenIn.${post.original_language}`)}>
                        {post.original_language.slice(0, 2).toUpperCase()}
                      </span>
                    )}
                  </span>
                  {tr?.excerpt && <span class="excerpt muted">{tr.excerpt}</span>}
                </span>
                <span class="label muted tags">{post.tags?.join(' · ')}</span>
                <Icon name="arrow" size={16} />
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Layout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--s-15);
    padding-block: var(--s-66) var(--s-33);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-top: var(--s-15);
  }

  .filter {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--te-grey-100);
  }

  .filter:hover {
    border-color: var(--te-black);
  }

  .filter[aria-current='true'] {
    background: var(--te-black);
    border-color: var(--te-black);
    color: var(--te-white);
    font-weight: var(--w-regular);
  }

  .list-wrap {
    padding-bottom: var(--s-66);
  }

  .post {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding-block: var(--s-22);
  }

  .post > :global(svg) {
    display: none;
  }

  @media (min-width: 720px) {
    .post {
      grid-template-columns: 160px 1fr 180px 16px;
      gap: var(--s-22);
      align-items: start;
    }

    .post > :global(svg) {
      display: block;
      margin-top: 4px;
    }

    .tags {
      text-align: right;
    }
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .title {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sub);
    line-height: 1.3;
  }

  .excerpt {
    max-width: 640px;
  }

  .post:hover .title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
</style>
