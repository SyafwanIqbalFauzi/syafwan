# ---------------------------------------------------------------
# Lokal (docker-compose.dev.yml). Salin ke .env lalu isi nilainya.
# ---------------------------------------------------------------

# Postgres dev
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=change-me

# Directus
DIRECTUS_KEY=generate-random-string
DIRECTUS_SECRET=generate-random-string
DIRECTUS_ADMIN_EMAIL=you@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
# URL Directus dari sisi host (script cms/ & import)
DIRECTUS_URL=http://localhost:8055

# Web (Astro)
PUBLIC_SITE_URL=http://localhost:4321
# URL publik Directus untuk gambar (/assets/...). Mirip prod: lewat proxy dev Astro di /panel
PUBLIC_CMS_URL=http://localhost:4321/panel
# PUBLIC_URL Directus (docker-compose.dev.yml); harus sama dengan PUBLIC_CMS_URL. Admin: http://localhost:4321/panel/admin
DIRECTUS_PUBLIC_URL=http://localhost:4321/panel
# URL Directus untuk fetch data dari server Astro
DIRECTUS_INTERNAL_URL=http://localhost:8055
# Static token user "web-reader" (read-only). Diisi otomatis oleh `npm run cms:bootstrap`
DIRECTUS_TOKEN=
# Token user "autoplay-reports" (hanya boleh membuat baris di autoplay_reports). Diisi oleh `node cms/autoplay-reports-setup.mjs`
DIRECTUS_REPORT_TOKEN=

# Hermes (halaman privat /agent). Kosongkan HERMES_API_KEY untuk menonaktifkan.
# API server Hermes di host; dari container dijangkau lewat gateway bridge Docker.
HERMES_API_URL=http://172.18.0.1:8642
HERMES_API_KEY=

# Google Analytics 4. Kosongkan untuk menonaktifkan
PUBLIC_GA_ID=
# Data stream ID (hanya referensi, tidak dipakai kode)
GA_STREAM_ID=
